;;; Portable version-1 data codec. No Lisp reader or evaluator is called.
;;; Load in LISP-MCP on the host and COMMON-LISP-USER in Genera.
;;; Strings contain wire ASCII codes, including literal tab/LF/CR bytes.

(defconstant +mcp-v1-max-depth+ 16)
(defconstant +mcp-v1-max-nodes+ 4096)
(defconstant +mcp-v1-max-text+ 1048576)
(defconstant +mcp-v1-max-integer+ 9223372036854775807)
(defconstant +mcp-v1-min-integer+ -9223372036854775808)

(defparameter *mcp-v1-operations* '(:hello :status :eval :request-status :interrupt :reset-listener-context :load :compile-file :run-tests :describe :apropos))
(defparameter *mcp-v1-error-codes*
  '(:unsupported-operation :invalid-request :unsupported-version
    :authentication-failed :world-mismatch :handshake-required
    :stale-generation :service-unavailable :package-not-found :reader-error
    :evaluation-error :busy :worker-unavailable :request-id-conflict
    :interrupted :interrupt-pending :interrupt-refused :request-not-active
    :file-error :load-error :compile-error :source-mismatch :transfer-error
    :unsupported-runner :test-runner-error :test-report-error :test-failure :inspection-error))
(defparameter *mcp-v1-keywords*
  '(:version :id :op :client :token :boot-id :service-id :world :package
    :busy :features :ok :form :timeout-ms :print-level :print-length
    :request-state :values :value-count :stdout :stderr :warnings
    :elapsed-ms :truncated :replaced :error :code :message :condition-type :target-id
    :active-request-id :worker-unavailable
    :result :history-limit :history-count :history-byte-limit :history-bytes
    :history-evictions :request-id-conflict
    :hello :status :eval :request-status :interrupt :reset-listener-context :load :running :completed :failed
    :original-path :path-kind :host-path :path :source-root :resolved-path :resolved-root
    :source-size :source-hash :file-error :load-error :source-mismatch
    :compile-file :output-path :compile-completed :warnings-p :failure-p :loaded :compile-error
    :source-transfer :transfer :source-text :temporary-path :cleanup :transfer-error
    :run-tests :runner :test-runners :test-status :passed :passed-count :failed-count
    :describe :apropos :limit :inspection-error
    :unsupported-runner :test-runner-error :test-report-error :test-failure
    :interrupt-pending :interrupt-refused :request-not-active
    :interrupt-state :pending :delivered :refused
    :interrupted :unknown :unsupported-operation :invalid-request
    :unsupported-version :expected-world :authentication-failed
    :world-mismatch :handshake-required :stale-generation :service-unavailable
    :package-not-found :reader-error :evaluation-error))

(defun mcp-v1-error (message)
  (error "Envelope error: ~A" message))

(defun mcp-v1-check-text (text)
  (unless (and (stringp text) (<= (length text) +mcp-v1-max-text+))
    (mcp-v1-error "Expected bounded ASCII text"))
  (dotimes (i (length text))
    (let ((code (char-code (char text i))))
      (unless (or (<= 32 code 126) (member code '(9 10 13)))
        (mcp-v1-error "Unsupported text character"))))
  text)

(defun mcp-v1-integer-p (value)
  (and (integerp value)
       (<= +mcp-v1-min-integer+ value +mcp-v1-max-integer+)))

(defun mcp-v1-check-tree (object)
  "Bound data before schema traversal, including dotted and cyclic lists."
  (let ((nodes 0))
    (labels ((visit (value depth)
               (when (> (incf nodes) +mcp-v1-max-nodes+)
                 (mcp-v1-error "Too many data nodes"))
               (cond ((or (null value) (eq value t)) nil)
                     ((stringp value) (mcp-v1-check-text value))
                     ((mcp-v1-integer-p value) nil)
                     ((member value *mcp-v1-keywords*) nil)
                     ((consp value)
                      (when (> depth +mcp-v1-max-depth+)
                        (mcp-v1-error "Nesting limit exceeded"))
                      (loop for tail = value then (cdr tail)
                            while tail
                            do (unless (consp tail)
                                 (mcp-v1-error "Dotted lists are forbidden"))
                               (visit (car tail) (1+ depth))))
                     (t (mcp-v1-error "Unsupported data type or symbol")))))
      (visit object 1)))
  object)

(defun mcp-v1-parse (text)
  "Parse only lists, known keywords, strings, signed integers, T and NIL."
  (mcp-v1-check-text text)
  (let ((index 0) (size (length text)) (nodes 0) (*read-eval* nil))
    (labels
        ((peek () (and (< index size) (char-code (char text index))))
         (space-p (code) (member code '(9 10 13 32)))
         (skip-space () (loop while (space-p (peek)) do (incf index)))
         (delimiter-p (code)
           (or (null code) (space-p code) (member code '(40 41))))
         (string-value ()
           (incf index)
           (with-output-to-string (out)
             (loop
               (let ((code (peek)))
                 (unless code (mcp-v1-error "Unterminated string"))
                 (incf index)
                 (cond ((= code 34) (return))
                       ((= code 92)
                        (setf code (peek))
                        (unless (member code '(34 92))
                          (mcp-v1-error "Only quote and backslash escapes are allowed"))
                        (incf index)
                        (write-char (code-char code) out))
                       (t (write-char (code-char code) out)))))))
         (token-value ()
           (let ((start index))
             (loop until (delimiter-p (peek))
                   do (incf index)
                      (when (> (- index start) 64)
                        (mcp-v1-error "Token limit exceeded")))
             (let* ((token (subseq text start index))
                    (length (length token)))
               (cond
                 ((zerop length) (mcp-v1-error "Expected a data value"))
                 ((string-equal token "nil") nil)
                 ((string-equal token "t") t)
                 ((char= (char token 0) #\:)
                  (or (find (subseq token 1) *mcp-v1-keywords*
                            :key #'symbol-name :test #'string-equal)
                      (mcp-v1-error "Unknown keyword")))
                 (t
                  (let* ((negative (char= (char token 0) #\-))
                         (first (if negative 1 0))
                         (number 0))
                    (unless (<= 1 (- length first) 19)
                      (mcp-v1-error "Expected a signed 64-bit decimal integer"))
                    (loop for i from first below length
                          for code = (char-code (char token i))
                          do (unless (<= 48 code 57)
                               (mcp-v1-error "Symbols and reader syntax are forbidden"))
                             (setf number (+ (* number 10) (- code 48))))
                    (when negative (setf number (- number)))
                    (unless (mcp-v1-integer-p number)
                      (mcp-v1-error "Integer limit exceeded"))
                    number))))))
         (value (depth)
           (skip-space)
           (when (> (incf nodes) +mcp-v1-max-nodes+)
             (mcp-v1-error "Too many data nodes"))
           (case (peek)
             ((nil) (mcp-v1-error "Missing data value"))
             (34 (string-value))
             (40
              (when (> depth +mcp-v1-max-depth+)
                (mcp-v1-error "Nesting limit exceeded"))
              (incf index)
              (let ((items nil))
                (loop
                  (skip-space)
                  (when (null (peek)) (mcp-v1-error "Unterminated list"))
                  (when (= (peek) 41) (incf index) (return))
                  (push (value (1+ depth)) items))
                (nreverse items)))
             (41 (mcp-v1-error "Unexpected closing parenthesis"))
             (otherwise (token-value)))))
      (let ((object (value 1)))
        (skip-space)
        (unless (= index size) (mcp-v1-error "Trailing data is forbidden"))
        object))))

(defun mcp-v1-plist (object allowed required)
  (unless (listp object) (mcp-v1-error "Expected a property list"))
  (let ((seen nil))
    (loop for tail = object then (cddr tail)
          while tail
          for key = (car tail)
          do (unless (and (consp (cdr tail)) (member key allowed))
               (mcp-v1-error "Unknown key or missing property value"))
             (when (member key seen) (mcp-v1-error "Duplicate property key"))
             (push key seen))
    (unless (every (lambda (key) (member key seen)) required)
      (mcp-v1-error "Missing required property")))
  object)

(defun mcp-v1-type-p (value type)
  (case type
    (:text (stringp value))
    (:nonempty-text (and (stringp value) (plusp (length value))))
    (:source-path (and (stringp value) (<= 1 (length value) 4096)))
    (:runner (and (stringp value) (<= 1 (length value) 128)
                  (every (lambda (ch) (<= 33 (char-code ch) 126)) value)))
    (:runner-names (and (listp value) (<= 1 (length value) 32)
                        (member "form" value :test #'equal)
                        (= (length value) (length (remove-duplicates value :test #'equal)))
                        (every (lambda (name) (mcp-v1-type-p name :runner)) value)))
    (:test-status (member value '(:passed :failed :unknown)))
    (:inspection-text (and (stringp value) (<= 1 (length value) 256)
                           (every (lambda (ch) (<= 32 (char-code ch) 126)) value)))
    (:match-limit (and (integerp value) (<= 1 value 100)))
    (:transfer-text (and (stringp value) (<= (length value) 65536)
                         (every (lambda (ch) (or (<= 32 (char-code ch) 126)
                                                 (member (char-code ch) '(9 10)))) value)))
    (:id (and (stringp value) (<= 1 (length value) 128)))
    (:boolean (or (null value) (eq value t)))
    (:nonnegative (and (mcp-v1-integer-p value) (>= value 0)))
    (:positive (and (mcp-v1-integer-p value) (> value 0)))
    (:print-limit (or (null value) (mcp-v1-type-p value :nonnegative)))
    (:strings (and (listp value) (every #'stringp value)))
    (:features (and (listp value)
                    (every (lambda (item) (or (eq item :source-transfer) (member item *mcp-v1-operations*))) value)))
    (:state (member value '(:running :completed :failed :interrupted :unknown)))
    (:interrupt-state (member value '(:pending :delivered :refused)))
    (otherwise nil)))

(defun mcp-v1-properties (object types)
  (loop for (key value) on object by #'cddr
        for type = (cdr (assoc key types))
        when (and type (not (mcp-v1-type-p value type)))
          do (mcp-v1-error "Invalid property type")))

(defun mcp-v1-present-p (object key)
  (loop for tail on object by #'cddr
        thereis (eq (car tail) key)))

(defun mcp-v1-validate (object direction)
  (mcp-v1-check-tree object)
  ;; Check list shape before GETF can traverse it as a property list.
  (unless (and (listp object) (evenp (length object)))
    (mcp-v1-error "Expected an even property list"))
  (let* ((request-keys
           (case (getf object :op)
             (:hello '(:client :token :expected-world))
             ((:status :reset-listener-context) '(:boot-id :service-id))
             (:eval '(:boot-id :service-id :package :form :timeout-ms
                      :print-level :print-length))
             ((:describe :apropos) '(:boot-id :service-id :package :form :limit))
             (:run-tests '(:boot-id :service-id :package :runner :form :timeout-ms :print-level :print-length))
             (:load '(:boot-id :service-id :package :timeout-ms :print-level :print-length
                      :original-path :path-kind :host-path :path :source-root :source-size :source-hash
                      :transfer :source-text))
             (:compile-file '(:boot-id :service-id :package :timeout-ms :print-level :print-length
                              :original-path :path-kind :host-path :path :source-root :source-size :source-hash :load
                              :transfer :source-text))
             ((:request-status :interrupt) '(:boot-id :service-id :target-id))))
         (response-keys
           '(:boot-id :service-id :world :package :busy :active-request-id :features :ok
             :request-state :values :value-count :stdout :stderr :warnings
             :elapsed-ms :truncated :replaced :error :target-id :result
             :history-limit :history-count :history-byte-limit :history-bytes
             :history-evictions :interrupt-state :original-path :path-kind :host-path :path :source-root
             :resolved-path :resolved-root :load :output-path :compile-completed :warnings-p :failure-p :loaded
             :transfer :temporary-path :cleanup :runner :test-runners :test-status :passed-count :failed-count)))
    (case direction
      (:request
       (mcp-v1-plist object (append '(:version :id :op) request-keys)
                     '(:version :id :op))
       (unless (member (getf object :op) *mcp-v1-operations*)
         (mcp-v1-error "Unknown operation"))
       (unless (eq (getf object :op) :hello)
         (dolist (key '(:boot-id :service-id))
           (unless (getf object key) (mcp-v1-error "Missing generation identity"))))
       (when (and (eq (getf object :op) :eval) (null (getf object :form)))
         (mcp-v1-error "Missing form text"))
       (when (member (getf object :op) '(:describe :apropos))
         (unless (and (mcp-v1-type-p (getf object :form) :inspection-text)
                      (or (not (mcp-v1-present-p object :package))
                          (mcp-v1-type-p (getf object :package) :inspection-text))
                      (if (eq (getf object :op) :apropos)
                          (mcp-v1-type-p (getf object :limit 50) :match-limit)
                          (not (mcp-v1-present-p object :limit))))
           (mcp-v1-error "Inspection requires bounded literal text and search limit")))
       (when (eq (getf object :op) :run-tests)
         (unless (and (mcp-v1-type-p (getf object :runner) :runner)
                      (if (equal (getf object :runner) "form")
                          (stringp (getf object :form)) (not (mcp-v1-present-p object :form))))
           (mcp-v1-error "Tests require a runner and a form only for the form runner")))
       (when (member (getf object :op) '(:load :compile-file))
         (when (or (getf object :transfer) (mcp-v1-present-p object :source-text))
           (unless (and (eq (getf object :transfer) t)
                        (member (getf object :path-kind) '("host" "relative") :test #'equal)
                        (mcp-v1-type-p (getf object :source-text) :transfer-text)
                        (eql (getf object :source-size) (length (getf object :source-text))))
             (mcp-v1-error "Transfer requires bounded normalized host source text and size")))
         (dolist (key '(:original-path :path-kind :path :source-root))
           (unless (getf object key) (mcp-v1-error "Incomplete load path")))
         (unless (member (getf object :path-kind) '("genera" "host" "relative") :test #'equal)
           (mcp-v1-error "Invalid path kind"))
         (unless (and (eq (mcp-v1-present-p object :source-size) (mcp-v1-present-p object :source-hash))
                      (or (equal (getf object :path-kind) "genera")
                          (and (getf object :host-path) (mcp-v1-present-p object :source-size))))
           (mcp-v1-error "Mapped loads require a host path and complete fingerprint"))
         (when (mcp-v1-present-p object :source-size)
           (unless (and (mcp-v1-type-p (getf object :source-size) :nonnegative)
                        (<= (getf object :source-size) 16777216)
                        (mcp-v1-type-p (getf object :source-hash) :nonnegative)
                        (<= (getf object :source-hash) 4294967295))
             (mcp-v1-error "Invalid source fingerprint"))))
       (when (and (member (getf object :op) '(:request-status :interrupt))
                  (null (getf object :target-id)))
         (mcp-v1-error "Missing target request identity")))
      (:response
       (mcp-v1-plist object (append '(:version :id) response-keys)
                     '(:version :id :ok))
       (when (some (lambda (key) (mcp-v1-present-p object key)) '(:runner :test-status :passed-count :failed-count))
         (unless (and (mcp-v1-type-p (getf object :runner) :runner)
                      (mcp-v1-type-p (getf object :test-status) :test-status)
                      (eq (mcp-v1-present-p object :passed-count) (mcp-v1-present-p object :failed-count)))
           (mcp-v1-error "Incomplete test outcome"))
         (when (mcp-v1-present-p object :passed-count)
           (unless (and (mcp-v1-type-p (getf object :passed-count) :nonnegative)
                        (mcp-v1-type-p (getf object :failed-count) :nonnegative)
                        (eq (getf object :test-status) (if (zerop (getf object :failed-count)) :passed :failed)))
             (mcp-v1-error "Inconsistent test counts")))
         (when (or (and (getf object :ok) (eq (getf object :test-status) :failed))
                   (and (eq (getf (getf object :error) :code) :test-failure)
                        (not (eq (getf object :test-status) :failed))))
           (mcp-v1-error "Inconsistent test failure")))
       (when (some (lambda (key) (mcp-v1-present-p object key))
                   '(:original-path :path-kind :host-path :path :source-root :resolved-path :resolved-root))
         (dolist (key '(:original-path :path-kind :path :source-root))
           (unless (getf object key) (mcp-v1-error "Incomplete load path metadata")))
         (unless (member (getf object :path-kind) '("genera" "host" "relative") :test #'equal)
           (mcp-v1-error "Invalid load result path kind"))
         (when (and (getf object :ok) (not (and (getf object :resolved-path) (getf object :resolved-root))))
           (mcp-v1-error "Load success requires canonical paths")))
       (when (some (lambda (key) (mcp-v1-present-p object key))
                   '(:transfer :temporary-path :cleanup))
         (unless (and (eq (getf object :transfer) t) (equal (getf object :cleanup) "retained")
                      (getf object :original-path)
                      (or (not (getf object :ok))
                          (equal (getf object :temporary-path) (getf object :resolved-path))))
           (mcp-v1-error "Invalid transfer outcome")))
       (when (some (lambda (key) (mcp-v1-present-p object key))
                   '(:load :output-path :compile-completed :warnings-p :failure-p :loaded))
         (dolist (key '(:load :compile-completed :warnings-p :failure-p :loaded :original-path))
           (unless (mcp-v1-present-p object key) (mcp-v1-error "Incomplete compilation result")))
         (when (or (and (getf object :ok)
                        (or (not (getf object :compile-completed)) (getf object :failure-p)
                            (not (getf object :output-path))
                            (not (eq (getf object :load) (getf object :loaded)))))
                   (and (not (getf object :failure-p))
                        (not (and (getf object :compile-completed) (getf object :output-path))))
                   (and (getf object :loaded)
                        (or (not (getf object :load)) (getf object :failure-p))))
           (mcp-v1-error "Inconsistent compilation outcome")))
       (when (mcp-v1-present-p object :result)
         (let ((result (getf object :result)))
           (mcp-v1-validate result :response)
           (unless (and (getf object :ok) (getf object :target-id)
                        (not (mcp-v1-present-p result :result))
                        (member (getf object :request-state) '(:completed :failed :interrupted))
                        (eq (getf object :request-state) (getf result :request-state))
                        (every (lambda (key) (equal (getf object key) (getf result key)))
                               '(:boot-id :service-id))
                        (equal (getf object :target-id) (getf result :id)))
             (mcp-v1-error "Invalid retained result"))
           (mcp-v1-check-eval-response
            (append (list :version 1 :op :eval :form "" :id (getf result :id))
                    (list :boot-id (getf object :boot-id)
                          :service-id (getf object :service-id))) result)))
       (if (getf object :ok)
           (when (getf object :error) (mcp-v1-error "Success cannot contain an error"))
           (let ((failure (getf object :error)))
             (mcp-v1-plist failure '(:code :message :condition-type) '(:code :message))
             (unless (and (member (getf failure :code) *mcp-v1-error-codes*)
                          (stringp (getf failure :message))
                          (or (not (mcp-v1-present-p failure :condition-type))
                              (stringp (getf failure :condition-type))))
               (mcp-v1-error "Invalid error data"))))
       (when (not (eq (not (null (getf object :boot-id)))
                      (not (null (getf object :service-id)))))
         (mcp-v1-error "Incomplete generation identity"))
       (when (or (mcp-v1-present-p object :values)
                 (mcp-v1-present-p object :value-count))
         (unless (and (mcp-v1-present-p object :values)
                      (mcp-v1-present-p object :value-count)
                      (listp (getf object :values))
                      (mcp-v1-integer-p (getf object :value-count))
                      (= (length (getf object :values)) (getf object :value-count)))
           (mcp-v1-error "Value count does not match values"))))
      (otherwise (mcp-v1-error "Expected request or response direction")))
    (unless (eql (getf object :version) 1)
      (mcp-v1-error "Unsupported version"))
    (mcp-v1-properties
     object '((:id . :id) (:client . :text) (:token . :text)
              (:boot-id . :id) (:service-id . :id) (:world . :nonempty-text)
              (:expected-world . :nonempty-text)
              (:package . :text) (:busy . :boolean) (:active-request-id . :id)
              (:runner . :runner) (:test-runners . :runner-names) (:test-status . :test-status)
              (:passed-count . :nonnegative) (:failed-count . :nonnegative)
              (:original-path . :source-path) (:path-kind . :nonempty-text)
              (:host-path . :source-path) (:path . :source-path) (:source-root . :source-path)
              (:resolved-path . :source-path) (:resolved-root . :source-path)
              (:output-path . :source-path) (:load . :boolean) (:compile-completed . :boolean)
              (:transfer . :boolean) (:source-text . :transfer-text) (:temporary-path . :source-path) (:cleanup . :text)
              (:warnings-p . :boolean) (:failure-p . :boolean) (:loaded . :boolean)
              (:features . :features)
              (:limit . :match-limit) (:ok . :boolean) (:form . :text) (:timeout-ms . :positive)
              (:print-level . :print-limit) (:print-length . :print-limit)
              (:target-id . :id) (:request-state . :state) (:values . :strings)
              (:interrupt-state . :interrupt-state)
              (:value-count . :nonnegative) (:stdout . :text) (:stderr . :text)
              (:warnings . :strings) (:elapsed-ms . :nonnegative)
              (:history-limit . :nonnegative) (:history-count . :nonnegative)
              (:history-byte-limit . :nonnegative) (:history-bytes . :nonnegative)
              (:history-evictions . :nonnegative)
              (:truncated . :boolean) (:replaced . :boolean))))
  object)

(defun mcp-v1-decode (text direction)
  (mcp-v1-validate (mcp-v1-parse text) direction))

(defun mcp-v1-check-hello-response (request response)
  "Validate a hello reply before trusting its identity or capabilities."
  (mcp-v1-validate request :request)
  (mcp-v1-validate response :response)
  (unless (and (eq (getf request :op) :hello)
               (string= (getf request :id) (getf response :id)))
    (mcp-v1-error "Hello response identity mismatch"))
  (when (getf response :ok)
    (dolist (key '(:boot-id :service-id :world :package :busy :features))
      (unless (mcp-v1-present-p response key)
        (mcp-v1-error "Incomplete hello response")))
    (when (and (getf request :expected-world)
               (not (string= (getf request :expected-world) (getf response :world))))
      (mcp-v1-error "Hello world mismatch")))
  (when (and (getf response :ok) (member :run-tests (getf response :features))
             (not (mcp-v1-type-p (getf response :test-runners) :runner-names)))
    (mcp-v1-error "Test capability requires an explicit runner catalogue"))
  response)

(defun mcp-v1-check-eval-response (request response)
  "Check execution identity and the complete terminal result contract."
  (mcp-v1-validate request :request)
  (mcp-v1-validate response :response)
  (unless (and (member (getf request :op) '(:eval :reset-listener-context :load :compile-file :run-tests :describe :apropos))
               (every (lambda (key) (equal (getf request key) (getf response key)))
                      '(:id :boot-id :service-id)))
    (mcp-v1-error "Eval response identity mismatch"))
  (when (or (getf response :ok) (getf response :request-state))
    (dolist (key '(:request-state :values :value-count :stdout :stderr :warnings
                   :package :elapsed-ms :truncated :replaced))
      (unless (mcp-v1-present-p response key)
        (mcp-v1-error "Incomplete eval response")))
    (unless (eq (getf response :request-state)
                (cond ((getf response :ok) :completed)
                      ((eq (getf (getf response :error) :code) :interrupted) :interrupted)
                      (t :failed)))
      (mcp-v1-error "Invalid terminal eval state"))
    (when (member (getf request :op) '(:load :compile-file))
      (unless (equal (getf request :transfer) (getf response :transfer))
        (mcp-v1-error "Transfer response option mismatch"))
      (dolist (key '(:original-path :path-kind :host-path :path :source-root))
        (unless (equal (getf request key) (getf response key))
          (mcp-v1-error "Load response path mismatch")))
      (when (and (getf response :ok)
                 (not (and (getf response :resolved-path) (getf response :resolved-root))))
        (mcp-v1-error "Load success requires resolved paths")))
    (when (eq (getf request :op) :compile-file)
      (dolist (key '(:load :compile-completed :warnings-p :failure-p :loaded))
        (unless (mcp-v1-present-p response key) (mcp-v1-error "Missing compilation outcome")))
      (unless (equal (getf request :load) (getf response :load))
        (mcp-v1-error "Compile response load option mismatch")))
    (when (eq (getf request :op) :run-tests)
      (unless (and (equal (getf request :runner) (getf response :runner))
                   (mcp-v1-present-p response :test-status))
        (mcp-v1-error "Test response runner or outcome mismatch")))
    (when (and (not (getf response :ok))
               (not (mcp-v1-present-p (getf response :error) :condition-type)))
      (mcp-v1-error "Missing execution condition type")))
  response)

(defun mcp-v1-encode (object direction)
  "Write validated data without inheriting Lisp printer or reader settings."
  (mcp-v1-validate object direction)
  (let ((count 0))
    (with-output-to-string (out)
      (labels ((emit (character)
                 (when (> (incf count) +mcp-v1-max-text+)
                   (mcp-v1-error "Encoded envelope exceeds frame limit"))
                 (write-char character out))
               (text (string) (map nil #'emit string))
               (value (item)
                 (cond ((null item) (text "nil"))
                       ((eq item t) (text "t"))
                       ((stringp item)
                        (emit #\")
                        (map nil (lambda (character)
                                   (when (member (char-code character) '(34 92))
                                     (emit #\\))
                                   (emit character)) item)
                        (emit #\"))
                       ((integerp item) (text (format nil "~D" item)))
                       ((keywordp item)
                        (emit #\:) (text (string-downcase (symbol-name item))))
                       (t
                        (emit #\()
                        (loop for tail on item
                              do (value (car tail))
                                 (when (cdr tail) (emit #\Space)))
                        (emit #\))))))
        (value object)))))
