;;; Real runner selection, report validation, admission, and ledger checks.
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)
(defvar *runner-checks* 0)
(defun rcheck (expected actual)
  (incf *runner-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(defun report-state () (list :test-status :unknown :counts-known nil :passed-count nil :failed-count nil))
(let ((state (report-state)))
  (mcp-note-test-report t state)
  (rcheck :unknown (getf state :test-status))
  (rcheck nil (getf state :counts-known))
  (mcp-note-test-report '(:test-status :passed :passed-count 5 :failed-count 0) state)
  (rcheck 5 (getf state :passed-count))
  (rcheck :passed (getf state :test-status)))
(dolist (bad '((:test-status :passed :passed-count 1)
               (:test-status :passed :passed-count 1 :failed-count 1)
               (:test-status :unknown :passed-count 1 :failed-count 0)
               (:test-status :passed :passed-count -1 :failed-count 0)
               (:test-status :passed :test-status :failed)))
  (rcheck :rejected (handler-case (mcp-note-test-report bad (report-state)) (error () :rejected))))
(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil) (*mcp-worker-failed* nil)
       (*mcp-bootstrap-service* nil)
       (adapter (lambda () :called))
       (*mcp-test-runners* (list (cons "suite" adapter))))
  (rcheck '("form" "suite") (mcp-test-runner-names))
  (mcp-start-service)
  (let* ((service *mcp-service*) (session (mcp-v1-new-session))
         (*mcp-current-connection* (mcp-admit-client 'tests service :v1))
         (request (append '(:version 1 :op :run-tests :id "tests" :runner "suite")
                          (mcp-v1-generation service))))
    (mcp-v1-dispatch '(:version 1 :op :hello :id "hello") session service)
    (let ((bad (copy-list request)))
      (setf (getf bad :runner) "absent")
      (rcheck :unsupported-runner (getf (getf (mcp-v1-dispatch bad session service) :error) :code))
      (rcheck nil (mcp-find-request service "tests"))
      (rcheck nil *mcp-worker-busy*))
    (rcheck nil (mcp-v1-dispatch request session service))
    (rcheck adapter (getf *mcp-worker-busy* :test-function))
    (rcheck :running (getf (mcp-v1-dispatch request session service) :request-state))
    (let ((changed (copy-list request)))
      (setf (getf changed :runner) "other")
      (rcheck :request-id-conflict (getf (getf (mcp-v1-dispatch changed session service) :error) :code)))
    (let* ((job *mcp-worker-busy*)
           (state (report-state))
           (result (progn (mcp-note-test-report '(:test-status :passed :passed-count 3 :failed-count 0) state)
                    (append '(:version 1 :id "tests" :ok t :request-state :completed :values ("report")
                              :value-count 1 :stdout "ran" :stderr "" :warnings nil :package "USER"
                              :elapsed-ms 1 :truncated nil :replaced nil)
                            (mcp-v1-generation service) (mcp-test-metadata request state)))))
      (rcheck result (mcp-v1-check-eval-response request result))
      (dolist (key '(:runner :test-status :passed-count :failed-count))
        (let ((bad (copy-tree result)))
          (remf bad key)
          (rcheck :rejected (handler-case (mcp-v1-check-eval-response request bad) (error () :rejected)))))
      (mcp-finish-job job result)
      (setf *mcp-test-runners* nil)
      (rcheck result (mcp-v1-dispatch request session service))
      (let* ((query (append '(:version 1 :op :request-status :id "query" :target-id "tests")
                            (mcp-v1-generation service)))
             (reply (mcp-v1-dispatch query session service)))
        (rcheck result (getf reply :result))
        (rcheck reply (mcp-v1-decode (mcp-v1-encode reply :response) :response))))))
(format t "~&Runner unit checks: ~D passed.~%" *runner-checks*)
