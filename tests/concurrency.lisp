;;; Admission and queue bounds use the real portable service implementation.

(load (merge-pathnames "../lisp-mcp.lisp" *load-truename*))
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)

(defvar *concurrency-checks* 0)
(defun ccheck (expected actual)
  (incf *concurrency-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(defun ccode (response) (getf (getf response :error) :code))

(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil)
       (*mcp-worker-failed* nil) (*mcp-bootstrap-service* nil)
       (*fixture-closed* nil))
  (mcp-start-service)
  (let* ((first (mcp-admit-client 'first *mcp-service* :v1))
         (second (mcp-admit-client 'second *mcp-service* :v1))
         (request (append '(:version 1 :id "eval-1" :op :eval :form "(+ 1 2)")
                          (mcp-v1-generation *mcp-service*))))
    (ccheck nil (mcp-submit-eval request *mcp-service* first))
    (let ((job *mcp-worker-busy*))
      (ccheck :pending (getf job :state))
      (ccheck job (getf first :execution))
      (ccheck :busy (ccode (mcp-submit-eval request *mcp-service* second)))
      (ccheck job *mcp-worker-busy*)
      (let ((reply (mcp-v1-service-response '(:id "status") *mcp-service*)))
        (ccheck t (getf reply :busy))
        (ccheck "eval-1" (getf reply :active-request-id)))
      (let ((*fixture-worker-owner* t) (worker *mcp-worker*))
        (let ((previous (getf *mcp-service* :service-id)))
          (mcp-start-service :replace t)
          (ccheck nil (equal previous (getf *mcp-service* :service-id)))
          (ccheck worker *mcp-worker*)
          (ccheck job *mcp-worker-busy*))))
    ;; Completed-but-unsent execution still owns the connection's result slot.
    (setf *mcp-worker-busy* nil)
    (ccheck :busy (ccode (mcp-submit-eval request *mcp-service* first)))
    (ccheck "eval-1" (getf (mcp-submit-eval request *mcp-service* first)
                            :active-request-id))
    (setf (getf first :execution) nil)
    (let ((*fixture-worker-live* nil))
      (ccheck :worker-unavailable (ccode (mcp-submit-eval request *mcp-service* first))))
    (let ((*mcp-worker-failed* t))
      (ccheck :worker-unavailable (ccode (mcp-submit-eval request *mcp-service* first))))
    (let ((*mcp-bootstrap-service* '(:clients (loader))))
      (ccheck :busy (ccode (mcp-submit-eval request *mcp-service* first))))
    (setf (getf first :closed) t)
    (ccheck :service-unavailable (ccode (mcp-submit-eval request *mcp-service* first))))
  (setf *mcp-connections* nil)
  (dotimes (i +mcp-client-limit+)
    (ccheck t (not (null (mcp-admit-client i *mcp-service* :v1)))))
  (ccheck nil (mcp-admit-client 'overflow *mcp-service* :v1))
  (let ((client (first *mcp-connections*)))
    (dotimes (i +mcp-control-limit+) (mcp-queue-response client i))
    (ccheck +mcp-control-limit+ (getf client :controls))
    (ccheck (loop for i below +mcp-control-limit+ collect i)
            (mapcar (lambda (entry) (getf entry :response)) (getf client :queue)))
    (mcp-queue-response client "execution" '(:state :done))
    (ccheck +mcp-control-limit+ (getf client :controls))
    (ccheck (1+ +mcp-control-limit+) (length (getf client :queue)))))

(format t "~&Concurrency unit checks: ~D passed.~%" *concurrency-checks*)
