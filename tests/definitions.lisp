;;; Real lookup adapter, capability, result, admission, and ledger checks.
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)
(defvar *definition-checks* 0)
(defun dcheck (expected actual)
  (incf *definition-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(defun drejected (function)
  (dcheck :rejected (handler-case (funcall function) (error () :rejected))))
(let ((package (make-package "MCP-DEFINITION-FIXTURE" :use nil)))
  (unwind-protect
      (let ((symbol (intern "KNOWN" package)))
        (dcheck "symbol-not-found"
                (getf (mcp-find-definition "ABSENT" package "function"
                          (lambda (&rest args) (declare (ignore args)) (error "Must not be called")))
                      :lookup-status))
        (dcheck nil (nth-value 1 (find-symbol "ABSENT" package)))
        (dolist (kind '("function" "variable"))
          (let ((result (mcp-find-definition "KNOWN" package kind
                         (lambda (target type chase patch)
                           (dcheck symbol target)
                           (dcheck (if (equal kind "function") 'defun 'defvar) type)
                           (dcheck nil chase) (dcheck nil patch)
                           (values #p"/actual/source.lisp" type)))))
            (dcheck "found" (getf result :lookup-status))
            (dcheck "/actual/source.lisp" (getf result :source-path))
            (dcheck "file" (getf result :location-kind))))
        (dcheck "source-unavailable"
                (getf (mcp-find-definition "KNOWN" package "function"
                          (lambda (&rest args) (declare (ignore args)) nil)) :lookup-status))
        (dolist (path (list "fake source" (parse-namestring (make-string 4097 :initial-element #\a))))
          (drejected (lambda () (mcp-find-definition "KNOWN" package "function"
                                  (lambda (&rest args) (declare (ignore args)) (values path 'defun)))))))
    (delete-package package)))
(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil) (*mcp-worker-failed* nil)
       (*mcp-bootstrap-service* nil) (*fixture-definition-function* nil))
  (mcp-start-service)
  (let* ((service *mcp-service*) (session (mcp-v1-new-session))
         (*mcp-current-connection* (mcp-admit-client 'lookup service :v1))
         (hello (mcp-v1-dispatch '(:version 1 :op :hello :id "hello") session service))
         (request (append '(:version 1 :op :find-definition :id "lookup" :form "KNOWN"
                            :definition-kind "function") (mcp-v1-generation service))))
    (dcheck nil (member :find-definition (getf hello :features)))
    (dcheck nil (getf hello :definition-kinds))
    (dcheck :unsupported-operation (getf (getf (mcp-v1-dispatch request session service) :error) :code))
    (dcheck nil (mcp-find-request service "lookup"))
    (let ((adapter (lambda (&rest args) (declare (ignore args)) nil)))
      (setf *fixture-definition-function* adapter)
      (dcheck '("function" "variable") (mcp-definition-kinds))
      (let ((hello (mcp-v1-dispatch '(:version 1 :op :hello :id "again") session service)))
        (dcheck t (not (null (member :find-definition (getf hello :features)))))
        (dcheck hello (mcp-v1-check-hello-response '(:version 1 :op :hello :id "again") hello))
        (let ((bad (copy-list hello)))
          (setf (getf bad :definition-kinds) nil)
          (drejected (lambda () (mcp-v1-check-hello-response '(:version 1 :op :hello :id "again") bad)))))
      (let ((bad (copy-list request)))
        (setf (getf bad :definition-kind) "method")
        (dcheck :unsupported-kind (getf (getf (mcp-v1-dispatch bad session service) :error) :code))
        (dcheck nil (mcp-find-request service "lookup")))
      (dcheck request (mcp-v1-decode (mcp-v1-encode request :request) :request))
      (dcheck nil (mcp-v1-dispatch request session service))
      (dcheck adapter (getf *mcp-worker-busy* :definition-function))
      (dcheck :running (getf (mcp-v1-dispatch request session service) :request-state))
      (let ((changed (copy-list request)))
        (setf (getf changed :definition-kind) "variable")
        (dcheck :request-id-conflict (getf (getf (mcp-v1-dispatch changed session service) :error) :code)))
      (let* ((location '(:lookup-status "found" :source-path "SYS:SITE;REAL-SOURCE"
                        :source-type "DEFUN" :location-kind "file"))
             (result (append '(:version 1 :id "lookup" :ok t :request-state :completed :values nil
                               :value-count 0 :stdout "" :stderr "" :warnings nil :package "USER"
                               :elapsed-ms 1 :truncated nil :replaced nil)
                             (mcp-v1-generation service) (mcp-definition-metadata request location))))
        (dcheck result (mcp-v1-check-eval-response request result))
        (dolist (key '(:definition-kind :symbol-name :lookup-status :source-path :source-type :location-kind))
          (let ((bad (copy-list result)))
            (remf bad key)
            (drejected (lambda () (mcp-v1-check-eval-response request bad)))))
        (let ((bad (copy-list result)))
          (setf (getf bad :source-type) "DEFMACRO")
          (drejected (lambda () (mcp-v1-check-eval-response request bad))))
        (mcp-finish-job *mcp-worker-busy* result)
        (setf *fixture-definition-function* nil)
        (dcheck result (mcp-v1-dispatch request session service))
        (let* ((query (append '(:version 1 :op :request-status :id "query" :target-id "lookup")
                              (mcp-v1-generation service)))
               (found (mcp-v1-dispatch query session service)))
          (dcheck result (getf found :result))
          (dcheck found (mcp-v1-decode (mcp-v1-encode found :response) :response)))))))
(format t "~&Definition unit checks: ~D passed.~%" *definition-checks*)
