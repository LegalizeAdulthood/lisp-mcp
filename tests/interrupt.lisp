;;; Exercise real listener dispatch, targeting, and terminal-result validation.
(load (merge-pathnames "../lisp-mcp.lisp" *load-truename*))
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)

(defvar *interrupt-checks* 0)
(defvar *interrupt-signals* 0)
(defun icheck (expected actual)
  (incf *interrupt-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(defun mcp-interrupt-supported-p () t)
(defun mcp-schedule-interrupt (job)
  (declare (ignore job)) (incf *interrupt-signals*))
(defun icode (response) (getf (getf response :error) :code))

(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil) (*mcp-worker-failed* nil)
       (*mcp-bootstrap-service* nil) (*interrupt-signals* 0))
  (mcp-start-service)
  (let* ((service *mcp-service*) (session (mcp-v1-new-session))
         (client (mcp-admit-client 'first service :v1))
         (work (append '(:version 1 :op :eval :id "work" :form "long") (mcp-v1-generation service)))
         (control (append '(:version 1 :op :interrupt :id "stop" :target-id "work")
                          (mcp-v1-generation service))))
    (icheck :handshake-required (icode (mcp-v1-dispatch control session service)))
    (icheck t (getf (mcp-v1-dispatch '(:version 1 :op :hello :id "hello") session service) :ok))
    (icheck :request-not-active (icode (mcp-v1-dispatch control session service)))
    (icheck nil (mcp-submit-eval work service client))
    (let* ((job *mcp-worker-busy*) (*mcp-interruptible-job* job))
      (let ((wrong (copy-list control)))
        (setf (getf wrong :target-id) "other")
        (icheck :request-not-active (icode (mcp-v1-dispatch wrong session service))))
      (let ((stale (copy-list control)))
        (setf (getf stale :service-id) "old")
        (icheck :stale-generation (icode (mcp-v1-dispatch stale session service))))
      (icheck 0 *interrupt-signals*)
      (icheck :interrupt-pending (icode (mcp-v1-dispatch control session service)))
      (icheck :interrupt-pending (icode (mcp-v1-dispatch control session service)))
      (icheck 1 *interrupt-signals*)
      (icheck t (mcp-interrupt-target-p job t))
      (icheck nil (mcp-interrupt-target-p job nil))
      (let ((*mcp-interruptible-job* nil)) (icheck nil (mcp-interrupt-target-p job t)))
      ;; An equal request ID in a successor job cannot receive delayed delivery.
      (let ((*mcp-worker-busy* (copy-list job))) (icheck nil (mcp-interrupt-target-p job t)))
      (let ((*mcp-service* (copy-list service))) (icheck nil (mcp-interrupt-target-p job t)))
      (setf (getf job :interrupt-state) :refused)
      (icheck :interrupt-refused (icode (mcp-v1-dispatch control session service)))
      (let* ((query (append '(:version 1 :op :request-status :id "lookup" :target-id "work")
                            (mcp-v1-generation service)))
             (lookup (mcp-v1-dispatch query session service)))
        (icheck :refused (getf lookup :interrupt-state))
        (icheck :running (getf lookup :request-state))
        (mcp-v1-encode lookup :response))
      (let ((result (append '(:version 1 :id "work" :ok nil :request-state :interrupted
                              :values nil :value-count 0 :stdout "before" :stderr ""
                              :warnings nil :package "USER" :elapsed-ms 4 :truncated nil :replaced nil
                              :error (:code :interrupted :condition-type "SYS:ABORT" :message "Interrupted"))
                            (mcp-v1-generation service))))
        (mcp-v1-check-eval-response work result)
        (mcp-finish-job job result)
        (let ((reply (mcp-v1-dispatch control session service)))
          (icheck t (getf reply :ok))
          (icheck :interrupted (getf reply :request-state))
          (icheck result (getf reply :result))
          (icheck reply (mcp-v1-decode (mcp-v1-encode reply :response) :response)))
        (let ((invalid (copy-tree result)))
          (setf (getf invalid :request-state) :failed)
          (icheck :rejected (handler-case (mcp-v1-check-eval-response work invalid)
                             (error () :rejected)))))
      (icheck 1 *interrupt-signals*))))
(format t "~&Interrupt unit checks: ~D passed.~%" *interrupt-checks*)
