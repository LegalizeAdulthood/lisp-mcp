;;; Real admission, identity, ledger, and result contracts for LOAD.
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)
(defvar *load-checks* 0)
(defun fcheck (expected actual)
  (incf *load-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil) (*mcp-worker-failed* nil)
       (*mcp-bootstrap-service* nil))
  (mcp-start-service)
  (let* ((service *mcp-service*) (session (mcp-v1-new-session))
         (*mcp-current-connection* (mcp-admit-client 'load service :v1))
         (request (append '(:version 1 :op :load :id "file" :original-path "SYS:SITE;test.lisp"
                            :path-kind "genera" :path "SYS:SITE;test.lisp" :source-root "SYS:SITE;")
                          (mcp-v1-generation service))))
    (fcheck :handshake-required (getf (getf (mcp-v1-dispatch request session service) :error) :code))
    (mcp-v1-dispatch '(:version 1 :op :hello :id "hello") session service)
    (fcheck nil (mcp-v1-dispatch request session service))
    (fcheck :running (getf (mcp-v1-dispatch request session service) :request-state))
    (let ((changed (copy-list request)))
      (setf (getf changed :path) "SYS:SITE;different.lisp")
      (fcheck :request-id-conflict (getf (getf (mcp-v1-dispatch changed session service) :error) :code)))
    (let* ((job *mcp-worker-busy*)
           (result (append '(:version 1 :id "file" :ok t :request-state :completed :values ("T")
                              :value-count 1 :stdout "loaded" :stderr "" :warnings nil :package "USER"
                              :elapsed-ms 1 :truncated nil :replaced nil)
                            (mcp-v1-generation service)
                            (mcp-load-metadata request '("FIXTURE-HOST:>sys>site>" "FIXTURE-HOST:>sys>site>test.lisp.1")))))
      (fcheck result (mcp-v1-check-eval-response request result))
      (let ((stale (copy-list request)))
        (setf (getf stale :service-id) "old")
        (fcheck :stale-generation (getf (getf (mcp-v1-dispatch stale session service) :error) :code)))
      (fcheck job *mcp-worker-busy*)
      (let ((bad (copy-tree result)))
        (remf bad :resolved-path)
        (fcheck :rejected (handler-case (mcp-v1-check-eval-response request bad) (error () :rejected))))
      (mcp-finish-job job result)
      (fcheck result (mcp-v1-dispatch request session service))
      (fcheck 1 (length (getf service :history)))
      (let* ((query (append '(:version 1 :op :request-status :id "query" :target-id "file")
                            (mcp-v1-generation service)))
             (reply (mcp-v1-dispatch query session service)))
        (fcheck result (getf reply :result))
        (fcheck reply (mcp-v1-decode (mcp-v1-encode reply :response) :response))))))
(format t "~&Load unit checks: ~D passed.~%" *load-checks*)
