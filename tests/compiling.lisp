;;; Actual admission and retained-result contracts for file compilation.
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)
(defvar *compile-checks* 0)
(defun ccheck (expected actual)
  (incf *compile-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil) (*mcp-worker-failed* nil)
       (*mcp-bootstrap-service* nil))
  (mcp-start-service)
  (let* ((service *mcp-service*) (session (mcp-v1-new-session))
         (*mcp-current-connection* (mcp-admit-client 'compile service :v1))
         (request (append '(:version 1 :op :compile-file :id "compile" :load t
                            :original-path "SYS:SITE;test.lisp" :path-kind "genera"
                            :path "SYS:SITE;test.lisp" :source-root "SYS:SITE;")
                          (mcp-v1-generation service))))
    (ccheck :handshake-required (getf (getf (mcp-v1-dispatch request session service) :error) :code))
    (mcp-v1-dispatch '(:version 1 :op :hello :id "hello") session service)
    (ccheck nil (mcp-v1-dispatch request session service))
    (ccheck :running (getf (mcp-v1-dispatch request session service) :request-state))
    (let ((changed (copy-list request)))
      (setf (getf changed :load) nil)
      (ccheck :request-id-conflict (getf (getf (mcp-v1-dispatch changed session service) :error) :code)))
    (let* ((job *mcp-worker-busy*)
           (result (append '(:version 1 :id "compile" :ok t :request-state :completed :values ("output")
                              :value-count 1 :stdout "" :stderr "" :warnings nil :package "USER"
                              :elapsed-ms 1 :truncated nil :replaced nil)
                            (mcp-v1-generation service)
                            (mcp-load-metadata request '("FIXTURE-HOST:>sys>site>" "FIXTURE-HOST:>sys>site>test.lisp.1")
                              '(:compile-completed t :warnings-p nil :failure-p nil :loaded t
                                :output-path "FIXTURE-HOST:>sys>site>fresh.vbin.1")))))
      (ccheck result (mcp-v1-check-eval-response request result))
      (dolist (key '(:compile-completed :warnings-p :failure-p :loaded :output-path))
        (let ((bad (copy-tree result)))
          (remf bad key)
          (ccheck :rejected (handler-case (mcp-v1-check-eval-response request bad) (error () :rejected)))))
      (dolist (pair '((:load nil) (:failure-p t) (:compile-completed nil) (:loaded nil)))
        (let ((bad (copy-tree result)))
          (setf (getf bad (first pair)) (second pair))
          (ccheck :rejected (handler-case (mcp-v1-check-eval-response request bad) (error () :rejected)))))
      (mcp-finish-job job result)
      (ccheck result (mcp-v1-dispatch request session service))
      (ccheck 1 (length (getf service :history)))
      (let* ((query (append '(:version 1 :op :request-status :id "query" :target-id "compile")
                            (mcp-v1-generation service)))
             (reply (mcp-v1-dispatch query session service)))
        (ccheck result (getf reply :result))
        (ccheck reply (mcp-v1-decode (mcp-v1-encode reply :response) :response))))))
(format t "~&Compile unit checks: ~D passed.~%" *compile-checks*)
