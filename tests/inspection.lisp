;;; Actual bounded lookup/search and common listener admission.
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)
(defvar *inspection-checks* 0)
(defun icheck (expected actual)
  (incf *inspection-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(let ((package (make-package "MCP-INSPECTION-FIXTURE" :use nil))
      (budget (make-mcp-budget)))
  (unwind-protect
      (progn
        (icheck nil (getf (mcp-inspect-symbol "MISSING" package budget) :found))
        (icheck nil (nth-value 1 (find-symbol "MISSING" package)))
        (let ((symbol (intern "KNOWN" package)))
          (setf (symbol-value symbol) (make-hash-table)
                (documentation symbol 'variable) (make-string 9000 :initial-element #\a))
          (let ((result (mcp-inspect-symbol "KNOWN" package budget)))
            (icheck t (getf result :found))
            (icheck t (getf result :bound))
            (icheck nil (getf result :fbound))
            (icheck 4096 (length (getf result :variable-documentation)))
            (icheck t (mcp-budget-truncated budget))))
        (dotimes (i 120) (intern (format nil "MATCH-~D" i) package))
        (let* ((budget (make-mcp-budget))
               (result (mcp-inspect-apropos "match-" package 3 budget)))
          (icheck 3 (length (getf result :matches)))
          (icheck nil (getf result :search-complete))
          (icheck t (mcp-budget-truncated budget)))
        (let ((result (mcp-inspect-apropos "absent" package 3 (make-mcp-budget))))
          (icheck nil (getf result :matches))
          (icheck t (getf result :search-complete)))
        (dotimes (i 10001) (intern (format nil "SCAN-~D" i) package))
        (let ((result (mcp-inspect-apropos "absent" package 3 (make-mcp-budget))))
          (icheck 10000 (getf result :scanned))
          (icheck nil (getf result :search-complete))))
    (delete-package package)))
(icheck t (getf (mcp-inspect-symbol "NIL" (find-package "COMMON-LISP") (make-mcp-budget)) :found))
(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil) (*mcp-worker-failed* nil)
       (*mcp-bootstrap-service* nil))
  (mcp-start-service)
  (let* ((service *mcp-service*) (session (mcp-v1-new-session))
         (*mcp-current-connection* (mcp-admit-client 'inspection service :v1))
         (request (append '(:version 1 :op :apropos :id "inspection" :form "MATCH" :limit 2)
                          (mcp-v1-generation service))))
    (mcp-v1-dispatch '(:version 1 :op :hello :id "hello") session service)
    (icheck request (mcp-v1-decode (mcp-v1-encode request :request) :request))
    (dolist (change '((:limit 0) (:limit 101) (:limit t) (:form "") (:form "#." :limit nil) (:package "")))
      (let ((bad (copy-list request)))
        (loop for (key value) on change by #'cddr do (setf (getf bad key) value))
        (icheck :rejected (handler-case (mcp-v1-encode bad :request) (error () :rejected)))))
    (icheck nil (mcp-v1-dispatch request session service))
    (icheck :running (getf (mcp-v1-dispatch request session service) :request-state))
    (let ((changed (copy-list request)))
      (setf (getf changed :limit) 3)
      (icheck :request-id-conflict (getf (getf (mcp-v1-dispatch changed session service) :error) :code)))
    (let ((other (copy-list request)))
      (setf (getf other :id) "other")
      (icheck :busy (getf (getf (mcp-v1-dispatch other session service) :error) :code)))
    (let ((result (append '(:version 1 :id "inspection" :ok t :request-state :completed
                           :values ("matches") :value-count 1 :stdout "" :stderr "" :warnings nil
                           :package "USER" :elapsed-ms 1 :truncated nil :replaced nil)
                         (mcp-v1-generation service))))
      (icheck result (mcp-v1-check-eval-response request result))
      (mcp-finish-job *mcp-worker-busy* result)
      (icheck result (mcp-v1-dispatch request session service)))))
(format t "~&Inspection unit checks: ~D passed.~%" *inspection-checks*)
