;;; Service state checks use real portable definitions and explicit API fixtures.

(load (merge-pathnames "../lisp-mcp.lisp" *load-truename*))
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)

(defvar *handshake-checks* 0)
(defun hcheck (expected actual)
  (incf *handshake-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(defun hrejected (function)
  (hcheck t (handler-case (progn (funcall function) nil) (error () t))))
(defun hcode (response) (getf (getf response :error) :code))
(defun hrequest (operation &rest properties)
  (append (list :version 1 :id "test" :op operation)
          (unless (eq operation :hello) (mcp-v1-generation *mcp-service*))
          properties))
(defmacro fresh-service (&body body)
  `(let ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-generation-counter* 0)
         (*mcp-protocol* :v1) (*mcp-worker-busy* nil) (*mcp-current-client* nil)
         (*fixture-enables* 0) (*fixture-disables* 0) (*fixture-closed* nil))
     ,@body))

(fresh-service
  (let ((first (mcp-start-service :token "test-secret")))
    (hcheck first (mcp-start-service))
    (hcheck 1 *fixture-enables*)
    (let* ((session (mcp-v1-new-session))
           (hello (hrequest :hello :token "test-secret" :expected-world "fixture.vlod"))
           (reply (mcp-v1-dispatch hello session)))
      (hcheck t (getf reply :ok))
      (hcheck '(:status) (getf reply :features))
      (hcheck "fixture.vlod" (getf reply :world))
      (hcheck nil (getf reply :busy))
      (hcheck reply (mcp-v1-dispatch hello session))
      (hcheck reply (lisp-mcp::mcp-v1-check-hello-response hello reply))
      (hcheck (mcp-v1-generation reply)
              (mcp-v1-generation (mcp-v1-dispatch (hrequest :status) session)))
      (let ((*mcp-worker-busy* t))
        (hcheck t (getf (mcp-v1-dispatch (hrequest :status) session) :busy))
        (hrejected #'mcp-stop-service)
        (hrejected (lambda () (mcp-start-service :replace t)))
        (hrejected #'mcp-initialize-boot)
        (hcheck first (mcp-start-service)))
      (dolist (key '(:boot-id :service-id))
        (let ((request (hrequest :status)))
          (setf (getf request key) "stale")
          (let ((failure (mcp-v1-dispatch request session)))
            (hcheck :stale-generation (hcode failure))
            (hcheck (mcp-v1-generation reply) (mcp-v1-generation failure)))))
      (hcheck :unsupported-operation
              (hcode (mcp-v1-dispatch (hrequest :eval :form "(error \"never\")") session)))
      (dolist (bad (list (hrequest :hello) (hrequest :hello :token "wrong")))
        (let ((failure (mcp-v1-dispatch bad session)))
          (hcheck :authentication-failed (hcode failure))
          (hcheck nil (getf failure :boot-id))
          (hcheck nil (getf failure :service-id))
          (hcheck nil (getf failure :world))
          (hcheck nil (getf failure :features))
          (hcheck :handshake-required (hcode (mcp-v1-dispatch (hrequest :status) session)))
          (hcheck nil (search "test-secret" (mcp-v1-encode failure :response)))))
      (let ((failure (mcp-v1-dispatch
                      (hrequest :hello :token "test-secret" :expected-world "wrong.vlod")
                      session)))
        (hcheck :world-mismatch (hcode failure))
        (hcheck nil (getf failure :world))
        (hcheck nil (getf session :authorized)))
      (mcp-v1-dispatch hello session)
      (let ((old-boot *mcp-boot-id*))
        (hcheck nil (equal first (mcp-start-service :replace t)))
        (hcheck old-boot *mcp-boot-id*)
        (hcheck :stale-generation (hcode (mcp-v1-dispatch (hrequest :status) session)))
        (hcheck :handshake-required
                (hcode (mcp-v1-dispatch (hrequest :status) (mcp-v1-new-session))))
        (mcp-initialize-boot)
        (hcheck nil (equal old-boot *mcp-boot-id*))
        (mcp-start-service)
        (hcheck "test-secret" (getf *mcp-service* :token))))
    (let ((id (getf *mcp-service* :service-id)))
      (dolist (arguments '((:protocol :legacy) (:token "changed") (:world "changed.vlod")
                           (:protocol :bad) (:token "") (:world "")))
        (hrejected (lambda () (apply #'mcp-start-service arguments)))
        (hcheck id (getf *mcp-service* :service-id)))
      (hcheck t (getf *mcp-service* :running)))))

(fresh-service
  (mcp-start-service)
  (setf (getf *mcp-service* :clients) '(current other))
  (let ((*mcp-current-client* 'current)) (mcp-stop-service))
  (hcheck '(other) *fixture-closed*)
  (hcheck nil (getf *mcp-service* :clients))
  (let ((stops *fixture-disables*))
    (mcp-stop-service)
    (hcheck stops *fixture-disables*))
  (hcheck :service-unavailable (hcode (mcp-v1-dispatch (hrequest :hello))))
  (let ((boot *mcp-boot-id*) (service (getf *mcp-service* :service-id)))
    (mcp-start-service)
    (hcheck boot *mcp-boot-id*)
    (hcheck nil (equal service (getf *mcp-service* :service-id)))))

(fresh-service
  (let ((*fixture-world* nil))
    (mcp-start-service :protocol :legacy)
    (hrejected (lambda () (mcp-start-service :protocol :v1 :replace t)))
    (hcheck :legacy (getf *mcp-service* :protocol))
    (hcheck t (getf *mcp-service* :running))
    (mcp-start-service :protocol :v1 :world "explicit.vlod" :replace t)
    (hcheck "explicit.vlod" (getf *mcp-service* :world))))

(let* ((hello '(:version 1 :id "hello" :op :hello :expected-world "fixture.vlod"))
       (reply '(:version 1 :id "hello" :ok t :boot-id "b" :service-id "s"
                :world "fixture.vlod" :package "USER" :busy nil :features (:status))))
  (dolist (key '(:boot-id :service-id :world :package :busy :features))
    (let ((incomplete (copy-list reply)))
      (remf incomplete key)
      (hrejected (lambda () (lisp-mcp::mcp-v1-check-hello-response hello incomplete)))))
  (dolist (change '((:world . "wrong.vlod") (:id . "wrong")))
    (let ((wrong (copy-list reply)))
      (setf (getf wrong (car change)) (cdr change))
      (hrejected (lambda () (lisp-mcp::mcp-v1-check-hello-response hello wrong))))))

(format t "~&Handshake unit checks: ~D passed.~%" *handshake-checks*)
