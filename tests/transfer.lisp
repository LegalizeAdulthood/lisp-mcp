;;; Real request identity, transfer metadata, and retained-result validation.
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)
(defvar *transfer-checks* 0)
(defun tcheck (expected actual)
  (incf *transfer-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil) (*mcp-worker-failed* nil)
       (*mcp-bootstrap-service* nil) (*mcp-transfer-root* nil))
  (mcp-start-service)
  (let* ((service *mcp-service*) (session (mcp-v1-new-session))
         (*mcp-current-connection* (mcp-admit-client 'transfer service :v1))
         (request (append '(:version 1 :op :load :id "transfer" :transfer t :source-text "(+ 1 2)"
                            :source-size 7 :source-hash 123 :host-path "/source/test.lisp"
                            :original-path "test.lisp" :path-kind "relative"
                            :path "SYS:SITE;test.lisp" :source-root "SYS:SITE;")
                          (mcp-v1-generation service))))
    (tcheck nil (member :source-transfer (getf (mcp-v1-dispatch '(:version 1 :op :hello :id "a") session service) :features)))
    (setf *mcp-transfer-root* "SYS:SITE;")
    (tcheck t (not (null (member :source-transfer (getf (mcp-v1-dispatch '(:version 1 :op :hello :id "b") session service) :features)))))
    (tcheck request (mcp-v1-decode (mcp-v1-encode request :request) :request))
    (dolist (pair '((:source-text "too long") (:source-size 0) (:transfer nil) (:path-kind "genera")))
      (let ((bad (copy-list request)))
        (setf (getf bad (first pair)) (second pair))
        (tcheck :rejected (handler-case (mcp-v1-validate bad :request) (error () :rejected)))))
    (let ((bad (copy-list request)))
      (setf (getf bad :source-text) (make-string 65537 :initial-element #\a) (getf bad :source-size) 65537)
      (tcheck :rejected (handler-case (mcp-v1-validate bad :request) (error () :rejected))))
    (tcheck nil (mcp-v1-dispatch request session service))
    (let ((changed (copy-list request)))
      (setf (getf changed :source-text) "(+ 2 1)")
      (tcheck :request-id-conflict (getf (getf (mcp-v1-dispatch changed session service) :error) :code)))
    (let* ((job *mcp-worker-busy*)
           (result (append '(:version 1 :id "transfer" :ok t :request-state :completed :values ("T")
                              :value-count 1 :stdout "" :stderr "" :warnings nil :package "USER"
                              :elapsed-ms 1 :truncated nil :replaced nil)
                            (mcp-v1-generation service)
                            (mcp-load-metadata request '("FIXTURE-HOST:>sys>site>" "FIXTURE-HOST:>sys>site>fresh.lisp.1")
                              nil '(:temporary-path "FIXTURE-HOST:>sys>site>fresh.lisp.1")))))
      (tcheck result (mcp-v1-check-eval-response request result))
      (dolist (key '(:transfer :cleanup :temporary-path))
        (let ((bad (copy-tree result)))
          (remf bad key)
          (tcheck :rejected (handler-case (mcp-v1-check-eval-response request bad) (error () :rejected)))))
      (mcp-finish-job job result)
      (tcheck result (mcp-v1-dispatch request session service))
      (let* ((query (append '(:version 1 :op :request-status :id "query" :target-id "transfer")
                            (mcp-v1-generation service)))
             (reply (mcp-v1-dispatch query session service)))
        (tcheck result (getf reply :result))
        (tcheck reply (mcp-v1-decode (mcp-v1-encode reply :response) :response))))))
(format t "~&Transfer unit checks: ~D passed.~%" *transfer-checks*)
