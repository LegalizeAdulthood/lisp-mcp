;;; Ledger checks use the real admission, completion, lookup, and codec paths.

(load (merge-pathnames "../lisp-mcp.lisp" *load-truename*))
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)

(defvar *ledger-checks* 0)
(defun lcheck (expected actual)
  (incf *ledger-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(defun lrequest (id &optional (form "(+ 1 2)"))
  (append (list :version 1 :id id :op :eval :form form)
          (mcp-v1-generation *mcp-service*)))
(defun lresult (request &optional failed)
  (append (list :version 1 :id (getf request :id) :ok (not failed))
          (mcp-v1-generation *mcp-service*)
          (list :request-state (if failed :failed :completed)
                :values (unless failed '("3")) :value-count (if failed 0 1)
                :stdout "before" :stderr "" :warnings nil :package "USER"
                :elapsed-ms 1 :truncated nil :replaced nil)
          (when failed (list :error '(:code :evaluation-error :message "failed"
                                     :condition-type "ERROR")))))
(defun llookup (id session)
  (mcp-v1-dispatch
   (append (list :version 1 :id "lookup" :op :request-status :target-id id)
           (mcp-v1-generation *mcp-service*)) session))
(defun lcomplete (id &optional failed)
  (let* ((client (mcp-admit-client id *mcp-service* :v1)) (request (lrequest id)))
    (lcheck nil (mcp-submit-eval request *mcp-service* client))
    (let ((job *mcp-worker-busy*) (result (lresult request failed)))
      (mcp-finish-job job result)
      (lcheck result (getf (first (getf client :queue)) :response))
      (lcheck nil *mcp-worker-busy*)
      (lcheck nil (getf *mcp-service* :active))
      result)))

(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil)
       (*mcp-worker-failed* nil) (*mcp-bootstrap-service* nil))
  (mcp-start-service)
  (let* ((session (mcp-v1-new-session))
         (hello (mcp-v1-dispatch '(:version 1 :id "hello" :op :hello) session))
         (client (mcp-admit-client 'first *mcp-service* :v1))
         (request (lrequest "once")))
    (lcheck '(:status :request-status :eval :reset-listener-context :load :compile-file :run-tests) (getf hello :features))
    (lcheck +mcp-history-limit+ (getf hello :history-limit))
    (lcheck +mcp-history-byte-limit+ (getf hello :history-byte-limit))
    (lcheck 0 (getf hello :history-count))
    (lcheck :unknown (getf (llookup "never-seen" session) :request-state))
    (lcheck nil (getf (llookup "never-seen" session) :result))
    (lcheck nil (mcp-submit-eval request *mcp-service* client))
    (let* ((job *mcp-worker-busy*) (entry (getf *mcp-service* :active))
           (result (lresult request)))
      (lcheck :pending (getf job :state))
      (lcheck entry (mcp-find-request *mcp-service* "once"))
      (lcheck :running (getf (llookup "once" session) :request-state))
      (lcheck :running (getf (mcp-submit-eval request *mcp-service* client)
                             :request-state))
      (lcheck job *mcp-worker-busy*)
      (lcheck :request-id-conflict
              (getf (getf (mcp-submit-eval (lrequest "once" "side effect")
                                           *mcp-service* client) :error) :code))
      ;; EOF must not discard the accepted identity or its terminal result.
      (setf (getf client :closed) t)
      (mcp-finish-job job result)
      (lcheck nil (getf client :queue))
      (lcheck nil *mcp-worker-busy*)
      (lcheck :done (getf job :state))
      (lcheck nil (getf entry :client))
      (lcheck nil (getf entry :service))
      (let ((lookup (llookup "once" session)))
        (lcheck "lookup" (getf lookup :id))
        (lcheck "once" (getf lookup :target-id))
        (lcheck :completed (getf lookup :request-state))
        (lcheck result (getf lookup :result))
        (lcheck lookup (mcp-v1-decode (mcp-v1-encode lookup :response) :response))
        (lcheck lookup (lisp-mcp::mcp-v1-decode
                        (mcp-v1-encode lookup :response) :response))
        (dolist (change '((:target-id . "wrong") (:request-state . :failed)
                          (:boot-id . "wrong") (:service-id . "wrong")))
          (let ((wrong (copy-list lookup)))
            (setf (getf wrong (car change)) (cdr change))
            (lcheck t (handler-case (progn (mcp-v1-validate wrong :response) nil)
                        (error () t))))))
      (let ((fresh (mcp-admit-client 'fresh *mcp-service* :v1)))
        (lcheck result (mcp-submit-eval request *mcp-service* fresh))
        ;; Equivalent property order does not create another execution.
        (lcheck result (mcp-submit-eval
                       (append (mcp-v1-generation *mcp-service*)
                               '(:form "(+ 1 2)" :op :eval :id "once" :version 1))
                       *mcp-service* fresh))
        (lcheck :request-id-conflict
                (getf (getf (mcp-submit-eval (append request '(:print-level 6))
                                             *mcp-service* fresh) :error) :code))
        (lcheck nil *mcp-worker-busy*)
        (lcheck 1 (length (getf *mcp-service* :history)))
        (lcheck (+ (length (mcp-v1-encode request :request))
                   (length (mcp-v1-encode result :response)))
                (getf *mcp-service* :history-bytes))
        (lcheck :unsupported-operation
                (getf (getf (mcp-submit-eval
                             (append (lrequest "deadline") '(:timeout-ms 1))
                             *mcp-service* fresh) :error) :code))
        (lcheck nil (mcp-find-request *mcp-service* "deadline"))))
    (let* ((result (lcomplete "failure" t)) (lookup (llookup "failure" session)))
      (lcheck t (getf lookup :ok))
      (lcheck :failed (getf lookup :request-state))
      (lcheck result (getf lookup :result))
      (lcheck lookup (mcp-v1-decode (mcp-v1-encode lookup :response) :response)))
    ;; Count eviction is oldest-completion first, not refreshed by lookup.
    (setf (getf *mcp-service* :history-limit) 2)
    (lcomplete "third")
    (lcheck :unknown (getf (llookup "once" session) :request-state))
    (lcheck 2 (length (getf *mcp-service* :history)))
    (lcheck 1 (getf *mcp-service* :history-evictions))
    ;; The byte budget accounts for source identity as well as results.
    (setf (getf *mcp-service* :history-byte-limit) 0)
    (lcomplete "fourth")
    (let ((status (mcp-v1-service-response '(:id "status") *mcp-service*)))
      (lcheck 0 (getf status :history-count))
      (lcheck 0 (getf status :history-bytes))
      (lcheck 4 (getf status :history-evictions))
      (lcheck :unknown (getf (llookup "fourth" session) :request-state)))
    ;; Active identities are never subject to completed-history eviction.
    (let ((fresh (mcp-admit-client 'active *mcp-service* :v1)))
      (mcp-submit-eval (lrequest "active") *mcp-service* fresh)
      (lcheck :running (getf (llookup "active" session) :request-state))
      (mcp-finish-job *mcp-worker-busy* (lresult (lrequest "active"))))
    (setf (getf *mcp-service* :history-byte-limit) +mcp-history-byte-limit+)
    (let ((result (lcomplete "retained")) (service *mcp-service*))
      (lcheck (getf service :service-id) (mcp-start-service))
      (lcheck result (getf (llookup "retained" session) :result))
      (let ((stale (append '(:version 1 :id "old" :op :request-status
                             :target-id "retained") (mcp-v1-generation service))))
        (mcp-start-service :replace t)
        (lcheck nil (equal (getf service :service-id) (getf *mcp-service* :service-id)))
        (lcheck :stale-generation (getf (getf (mcp-v1-dispatch stale session)
                                             :error) :code))
        (mcp-v1-dispatch '(:version 1 :id "hello" :op :hello) session)
        (lcheck :unknown (getf (llookup "retained" session) :request-state))
        (lcheck 0 (getf (mcp-v1-service-response '(:id "status") *mcp-service*)
                        :history-evictions))))))

(format t "~&Ledger unit checks: ~D passed.~%" *ledger-checks*)
