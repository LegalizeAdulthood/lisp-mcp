;;; Reset uses the same admission, generation, deduplication, and ledger.
(load (merge-pathnames "service-fixture.lisp" *load-truename*))
(in-package #:genera-protocol-fixture)

(defvar *context-checks* 0)
(defun ccheck (expected actual)
  (incf *context-checks*)
  (unless (equal expected actual) (error "Expected ~S, got ~S" expected actual)))
(defun ccode (response) (getf (getf response :error) :code))

(let* ((*mcp-service* nil) (*mcp-boot-id* nil) (*mcp-protocol* :v1)
       (*mcp-connections* nil) (*mcp-worker-busy* nil) (*mcp-worker-failed* nil)
       (*mcp-bootstrap-service* nil))
  (mcp-start-service)
  (let* ((service *mcp-service*) (session (mcp-v1-new-session))
         (*mcp-current-connection* (mcp-admit-client 'first service :v1))
         (other (mcp-admit-client 'second service :v1))
         (reset (append '(:version 1 :op :reset-listener-context :id "reset")
                        (mcp-v1-generation service)))
         (eval (append '(:version 1 :op :eval :id "eval" :form "42")
                       (mcp-v1-generation service))))
    (ccheck :handshake-required (ccode (mcp-v1-dispatch reset session service)))
    (ccheck t (getf (mcp-v1-dispatch '(:version 1 :op :hello :id "hello") session service) :ok))
    (let ((stale (copy-list reset)))
      (setf (getf stale :boot-id) "old")
      (ccheck :stale-generation (ccode (mcp-v1-dispatch stale session service))))
    (ccheck nil *mcp-worker-busy*)
    (ccheck nil (mcp-submit-eval eval service other))
    (let ((job *mcp-worker-busy*))
      (ccheck :busy (ccode (mcp-v1-dispatch reset session service)))
      (ccheck job *mcp-worker-busy*)
      (ccheck nil (mcp-find-request service "reset"))
      (let ((terminal (append '(:version 1 :id "eval" :ok t :request-state :completed
                               :values ("42") :value-count 1 :stdout "before" :stderr ""
                               :warnings nil :package "USER" :elapsed-ms 1 :truncated nil :replaced nil)
                              (mcp-v1-generation service))))
        (mcp-finish-job job terminal)
        (ccheck nil (mcp-v1-dispatch reset session service))
        (let* ((reset-job *mcp-worker-busy*)
               (result (copy-tree terminal)))
          (setf (getf result :id) "reset" (getf result :values) '("\"USER\""))
          (mcp-v1-check-eval-response reset result)
          (ccheck :busy (ccode (mcp-submit-eval
                                (append '(:version 1 :op :eval :id "later" :form "7")
                                        (mcp-v1-generation service)) service other)))
          (ccheck :running (getf (mcp-v1-dispatch reset session service) :request-state))
          (mcp-finish-job reset-job result)
          (ccheck result (mcp-v1-dispatch reset session service))
          (ccheck terminal (getf (mcp-find-request service "eval") :result))
          (ccheck 2 (length (getf service :history)))
          (ccheck nil *mcp-worker-busy*)
          ;; Reusing this ID for an eval cannot bypass operation identity.
          (setf (getf eval :id) "reset")
          (ccheck :request-id-conflict (ccode (mcp-v1-dispatch eval session service)))
          (let ((query (append '(:version 1 :op :request-status :id "query" :target-id "reset")
                               (mcp-v1-generation service))))
            (ccheck result (getf (mcp-v1-dispatch query session service) :result))
            (mcp-v1-encode (mcp-v1-dispatch query session service) :response)))))))
(format t "~&Context unit checks: ~D passed.~%" *context-checks*)
