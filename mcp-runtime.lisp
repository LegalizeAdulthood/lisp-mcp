;;; MCP reader, serialized tool worker, and single JSON-RPC response writer.

(in-package #:lisp-mcp)

(defstruct rpc-runtime input output diagnostic writer worker control-worker interrupt-worker session
  (lock (sb-thread:make-mutex :name "MCP runtime"))
  (changed (sb-thread:make-waitqueue :name "MCP runtime"))
  (version "2024-11-05") initialized input-closed stop writer-stop failed
  replies work control-work interrupt-work interrupt-supported tools-dirty (calls (make-hash-table :test 'equal)))
(defvar *rpc-runtime* nil)
(defconstant +rpc-work-limit+ 16)
(defconstant +rpc-reply-limit+ 32)

(define-condition rpc-argument-error (simple-error) ())
(defun rpc-invalid (message)
  (error 'rpc-argument-error :format-control "~A" :format-arguments (list message)))
(defun rpc-boolean (value) (if value 'yason:true 'yason:false))
(defun rpc-name (value) (string-downcase (symbol-name value)))
(defun rpc-key (value)
  (if (eq value :id) "request_id" (substitute #\_ #\- (rpc-name value))))

(defun rpc-bridge-json (envelope)
  (let ((object (jso)))
    (loop for (key value) on envelope by #'cddr
          do (setf (gethash (rpc-key key) object)
                   (cond ((member key '(:ok :busy :truncated :replaced :world-state-lost :history-lost
                                        :load :compile-completed :warnings-p :failure-p :loaded))
                          (rpc-boolean value))
                         ((member key '(:values :warnings)) (coerce value 'vector))
                         ((eq key :features) (map 'vector #'rpc-name value))
                         ((member key '(:error :result)) (rpc-bridge-json value))
                         ((keywordp value) (rpc-name value))
                         (t value))))
    object))

(defun rpc-tool-result (id text failed &optional structured)
  (let ((result (jso "content" (vector (jso "type" "text" "text" text))
                     "isError" (rpc-boolean failed))))
    (when (and structured (string= (rpc-runtime-version *rpc-runtime*) "2025-06-18"))
      (setf (gethash "structuredContent" result) structured))
    (make-response id result)))

(defun rpc-structured-result (id object &optional failed)
  (rpc-tool-result id (with-output-to-string (out) (yason:encode object out)) failed object))

(defun rpc-startup-status (cycle)
  (let* ((report (genera-startup-cycle-launch-info cycle))
         (process (getf report :process))
         (status (jso "cycle" (genera-startup-cycle-id cycle)
                      "active" (rpc-boolean (not (genera-startup-cycle-done cycle)))
                      "phase" (rpc-name (genera-startup-cycle-phase cycle))
                      "remaining_ms" (if (genera-startup-cycle-done cycle) 0
                                         (max 0 (ceiling (* 1000 (- (genera-startup-cycle-deadline cycle) (genera-now))))))
                      "launch_attempted" (rpc-boolean (genera-startup-cycle-launch-attempted cycle)))))
    (dolist (key '(:code :log :root :launcher-pid :exit-code))
      (when (getf report key)
        (setf (gethash (rpc-key key) status) (if (keywordp (getf report key))
                                               (rpc-name (getf report key)) (getf report key)))))
    (when process
      (setf (gethash "process" status)
            (jso "pid" (getf process :pid) "uid" (getf process :uid)
                 "start_time" (getf process :start-time) "linux_boot" (getf process :linux-boot)
                 "executable" (getf (getf process :executable) :path)
                 "world" (getf (getf process :world) :path)
                 "partition" (getf (getf process :partition) :path))))
    status))

(defun rpc-session-status ()
  "Local facts only; this function never opens or refreshes a connection."
  (let ((session (rpc-runtime-session *rpc-runtime*)))
    (if (null session)
        (jso "state" "disconnected" "phase" "not-started" "connected" 'yason:false
             "busy" 'yason:false "remote_status_stale" 'yason:true "pending_requests" 0)
        (sb-thread:with-mutex ((genera-session-lock session))
          (let* ((hello (genera-session-hello session))
                 (cycle (genera-session-startup session))
                 (starting (and cycle (not (genera-startup-cycle-done cycle))))
                 (work (genera-session-execution session))
                 (failure (genera-session-failure session))
                 (connected (and (eq (genera-session-state session) :ready)
                                 (not (genera-session-stop session))))
                 (status (jso "state" (cond ((and work (or failure (genera-request-failure work)
                                                          (eq (genera-request-state work) :unresolved)))
                                              "outcome-unknown")
                                             (starting "starting")
                                             ((and cycle (genera-startup-cycle-failure cycle)) "failed")
                                             (failure "disconnected")
                                             ((not connected) "connecting")
                                             (work "executing") (t "ready"))
                              "phase" (rpc-name (if starting (genera-startup-cycle-phase cycle)
                                                     (genera-session-phase session)))
                              "connected" (rpc-boolean connected)
                              "busy" (rpc-boolean (or work (getf (genera-session-cached-status session) :busy)))
                              "remote_status_stale"
                              (rpc-boolean (or (not connected) work (genera-session-status-stale session)
                                               (null (genera-session-cached-at session))
                                               (>= (- (genera-now) (or (genera-session-cached-at session) 0))
                                                   (genera-session-health-interval session))))
                              "reconnect_attempts" (genera-session-reconnects session)
                              "reconnect_failures" (genera-session-failures session)
                              "pending_requests" (hash-table-count (genera-session-pending session))
                              "history_limit" +genera-history-limit+
                              "history_evicted" (genera-session-history-evicted session)
                              "history" (map 'vector (lambda (item)
                                (let ((entry (rpc-bridge-json
                                              (loop for key in '(:id :boot-id :service-id)
                                                    append (list key (getf (genera-request-envelope item) key))))))
                                  (setf (gethash "request_state" entry) (rpc-name (genera-request-state item))
                                        (gethash "acknowledged" entry) (rpc-boolean (genera-request-acknowledged item)))
                                  entry)) (genera-session-history session)))))
            (dolist (key '(:boot-id :service-id :world :package))
              (when (getf hello key) (setf (gethash (rpc-key key) status) (getf hello key))))
            (when cycle (setf (gethash "startup" status) (rpc-startup-status cycle)))
            (when (genera-session-cached-at session)
              (setf (gethash "remote_observed_at" status) (genera-session-observed-at session)
                    (gethash "remote_observation_age_ms" status)
                    (floor (* 1000 (- (genera-now) (genera-session-cached-at session))))))
            (when (genera-session-generation-change session)
              (setf (gethash "generation_change" status)
                    (rpc-bridge-json (genera-session-generation-change session))))
            (when work
              (setf (gethash "active_request_id" status)
                    (getf (genera-request-envelope work) :id)
                    (gethash "request_state" status) (rpc-name (genera-request-state work)))
              (when (or (genera-request-failure work) (eq (genera-request-state work) :unresolved))
                (setf (gethash "unresolved_request" status)
                      (rpc-bridge-json (loop for key in '(:id :boot-id :service-id)
                                             append (list key (getf (genera-request-envelope work) key)))))))
            (when failure
              (setf (gethash "last_error" status)
                    (or (when (genera-session-error-response failure)
                          (rpc-bridge-json (getf (genera-session-error-response failure) :error)))
                        (jso "code" (rpc-name (genera-session-error-kind failure))
                             "message" (princ-to-string failure)))))
            status)))))

(defun rpc-tool-failure (id code message &optional request context)
  (let ((object (jso "ok" 'yason:false "error" (jso "code" code "message" message)
                     "session" (rpc-session-status))))
    (when request
      (dolist (key '(:id :boot-id :service-id))
        (setf (gethash (rpc-key key) object) (getf (genera-request-envelope request) key)))
      (setf (gethash "request_state" object) (rpc-name (genera-request-state request))))
    (when (string= *profile* "genera") (setf (gethash "timeout_enforced_by" object) "host"))
    (when context (maphash (lambda (key value) (setf (gethash key object) value)) context))
    (rpc-structured-result id object t)))

(defun rpc-file-tool-p (name)
  (member name '("genera_load" "genera_compile_file") :test #'equal))

(defun rpc-load-context (arguments request &optional path)
  (let ((object (rpc-bridge-json
                 (loop for key in '(:host-path :path :source-root)
                       for value = (and request (getf (genera-request-envelope request) key))
                       when value append (list key value)))))
    (setf (gethash "original_path" object) (gethash "path" arguments)
          (gethash "path_kind" object) (gethash "path_kind" arguments))
    (when path
      (setf (gethash "host_path" object) (genera-source-path-host-path path)
            (gethash "path" object) (genera-source-path-genera-path path)))
    object))

(defun rpc-emit (runtime response)
  (when response
    (sb-thread:with-mutex ((rpc-runtime-lock runtime))
      (loop while (and (>= (length (rpc-runtime-replies runtime)) +rpc-reply-limit+)
                       (not (rpc-runtime-stop runtime)) (not (rpc-runtime-failed runtime)))
            do (sb-thread:condition-wait (rpc-runtime-changed runtime) (rpc-runtime-lock runtime)))
      (unless (or (rpc-runtime-stop runtime) (rpc-runtime-failed runtime))
        (setf (rpc-runtime-replies runtime)
              (nconc (rpc-runtime-replies runtime) (list response)))
        (sb-thread:condition-broadcast (rpc-runtime-changed runtime))))))

(defun rpc-note-features (runtime features)
  ;; The socket owner must not wait for room in the response queue.
  (sb-thread:with-mutex ((rpc-runtime-lock runtime))
    (let ((supported (not (null (member :interrupt features)))))
      (unless (eq supported (rpc-runtime-interrupt-supported runtime))
        (setf (rpc-runtime-interrupt-supported runtime) supported
              (rpc-runtime-tools-dirty runtime) t)
        (sb-thread:condition-broadcast (rpc-runtime-changed runtime))))))

(defun rpc-write-loop (runtime)
  (handler-case
      (let ((*standard-output* (rpc-runtime-output runtime)))
        (loop
          (let ((response
                  (sb-thread:with-mutex ((rpc-runtime-lock runtime))
                    (loop while (and (null (rpc-runtime-replies runtime))
                                     (not (rpc-runtime-tools-dirty runtime))
                                     (not (rpc-runtime-writer-stop runtime)))
                          do (sb-thread:condition-wait (rpc-runtime-changed runtime)
                                                       (rpc-runtime-lock runtime)))
                    (when (and (null (rpc-runtime-replies runtime))
                               (not (rpc-runtime-tools-dirty runtime))) (return))
                    (prog1 (if (rpc-runtime-replies runtime) (pop (rpc-runtime-replies runtime))
                               (progn (setf (rpc-runtime-tools-dirty runtime) nil)
                                      (jso "jsonrpc" "2.0" "method" "notifications/tools/list_changed")))
                      (sb-thread:condition-broadcast (rpc-runtime-changed runtime))))))
            (write-json-rpc response)
            (sb-thread:with-mutex ((rpc-runtime-lock runtime))
              (remhash (gethash "id" response) (rpc-runtime-calls runtime))))))
    (error ()
      (sb-thread:with-mutex ((rpc-runtime-lock runtime))
        (setf (rpc-runtime-failed runtime) t)
        (sb-thread:condition-broadcast (rpc-runtime-changed runtime))))))

(defun rpc-run-work (task)
  (destructuring-bind (id name expression request) task
    (handler-case
        (cond
          ((string= name "genera_ensure_session")
           (genera-await-startup (rpc-runtime-session *rpc-runtime*) expression)
           (let ((status (rpc-session-status)))
             (setf (gethash "joined_cycle" status) (genera-startup-cycle-id expression))
             (rpc-structured-result id status)))
          ((string= name "genera_session_status")
           (let ((session (rpc-runtime-session *rpc-runtime*)))
             (genera-control-connection session)
             (let ((response (genera-call session :status)))
               (if (getf response :ok) (rpc-structured-result id (rpc-session-status))
                   (rpc-structured-result id (rpc-bridge-json response) t)))))
          ((string= name "genera_interrupt")
           (let ((response (genera-interrupt-request (rpc-runtime-session *rpc-runtime*)
                             (gethash "request_id" expression) (gethash "boot_id" expression)
                             (gethash "service_id" expression)
                             (/ (gethash "timeout_ms" expression 5000) 1000))))
             (rpc-structured-result id (rpc-bridge-json response))))
          ((member name '("genera_request_status" "genera_recover_session") :test #'equal)
           (let* ((session (rpc-runtime-session *rpc-runtime*))
                  (arguments expression)
                  (identity (mapcar (lambda (key) (gethash key arguments))
                                    '("request_id" "boot_id" "service_id")))
                  (outcome (multiple-value-list (if (string= name "genera_request_status")
                                (apply #'genera-lookup-request session identity)
                                (apply #'genera-recover-request session
                                       (append identity (list (gethash "expected_boot_id" arguments)
                                                              (gethash "expected_service_id" arguments)
                                                              (eq (gethash "acknowledge_unknown" arguments)
                                                                  'yason:true)))))))
                  (response (first outcome))
                  (object (rpc-bridge-json response)))
             (if (string= name "genera_request_status")
                 (setf (gethash "source" object) (rpc-name (second outcome)))
                 (setf (gethash "acknowledged" object) 'yason:true
                       (gethash "history_lost" object)
                       (rpc-boolean (not (and (equal (gethash "boot_id" arguments)
                                                     (gethash "expected_boot_id" arguments))
                                              (equal (gethash "service_id" arguments)
                                                     (gethash "expected_service_id" arguments)))))))
             (rpc-structured-result id object (not (getf response :ok)))))
          (request
            (let* ((session (rpc-runtime-session *rpc-runtime*))
                   (response
                     (progn
                       (when (rpc-file-tool-p name)
                         (let ((fields
                                 (sb-ext:with-timeout (max .001 (- (genera-request-deadline request) (genera-now)))
                                  (append (genera-load-fields (gethash "path_kind" expression) (gethash "path" expression))
                                     (when (string= name "genera_compile_file")
                                       (list :load (eq (gethash "load" expression) 'yason:true)))
                                     (list :print-level (gethash "print_level" expression 6)
                                           :print-length (gethash "print_length" expression 100))
                                     (when (gethash "package" expression)
                                       (list :package (gethash "package" expression)))))))
                           ;; Cancel the local I/O timer before publishing runnable work.
                           (genera-complete-preparation session request fields)))
                       (genera-await-request session request)))
                   (object (rpc-bridge-json response)))
              (when (rpc-file-tool-p name)
                (maphash (lambda (key value) (unless (gethash key object) (setf (gethash key object) value)))
                         (rpc-load-context expression request)))
              (setf (gethash "timeout_enforced_by" object) "host")
              (rpc-structured-result id object (not (getf response :ok)))))
          (t
            (multiple-value-bind (text failed)
                (cond ((string= name "eval_host_cl") (eval-host-cl expression))
                      ((string= name "eval_swank") (eval-swank-tool expression))
                      (t (eval-genera expression)))
              (rpc-tool-result id text failed))))
      (genera-path-error (condition)
        (genera-cancel-preparation (rpc-runtime-session *rpc-runtime*) request
                                  (genera-path-error-kind condition) (princ-to-string condition))
        (rpc-tool-failure id (rpc-name (genera-path-error-kind condition)) (princ-to-string condition)
                          request (rpc-load-context expression request (genera-path-error-path condition))))
      (sb-ext:timeout ()
        (genera-cancel-preparation (rpc-runtime-session *rpc-runtime*) request :timeout "File preparation deadline expired")
        (rpc-tool-failure id "timeout" "File preparation deadline expired; execution was not submitted"
                          request (rpc-load-context expression request)))
      (genera-session-error (condition)
        (when (and request (rpc-file-tool-p name))
          (genera-cancel-preparation (rpc-runtime-session *rpc-runtime*) request
                                    (genera-session-error-kind condition) (princ-to-string condition)))
        (if (string= name "genera_interrupt")
            (let ((object (jso "ok" 'yason:false
                              "error" (jso "code" (rpc-name (genera-session-error-kind condition))
                                           "message" (princ-to-string condition))
                              "session" (rpc-session-status))))
              (dolist (key '("request_id" "boot_id" "service_id"))
                (setf (gethash key object) (gethash key expression)))
              (when (genera-session-error-response condition)
                (setf (gethash "observation" object)
                      (rpc-bridge-json (genera-session-error-response condition))))
              (rpc-structured-result id object t))
        (rpc-tool-failure id (rpc-name (or (getf (getf (genera-session-error-response condition) :error) :code)
                                          (genera-session-error-kind condition)))
                          (princ-to-string condition) request
                          (when (rpc-file-tool-p name) (rpc-load-context expression request)))))
      (error ()
        (when (and request (rpc-file-tool-p name))
          (genera-cancel-preparation (rpc-runtime-session *rpc-runtime*) request :internal-error "File preparation failed"))
        (rpc-tool-failure id "internal-error" "Tool execution failed" request
                          (when (rpc-file-tool-p name) (rpc-load-context expression request)))))))

(defun rpc-pending-work (runtime control)
  (cond ((eq control :interrupt) (rpc-runtime-interrupt-work runtime))
        (control (rpc-runtime-control-work runtime))
        (t (rpc-runtime-work runtime))))

(defun rpc-pop-work (runtime control)
  (cond ((eq control :interrupt) (pop (rpc-runtime-interrupt-work runtime)))
        (control (pop (rpc-runtime-control-work runtime)))
        (t (pop (rpc-runtime-work runtime)))))

(defun rpc-work-loop (runtime &optional control)
  ;; Preserve generic host/Swank ordering while the reader handles other RPCs.
  (let* ((input (make-string-input-stream ""))
         (terminal (make-two-way-stream input (rpc-runtime-diagnostic runtime)))
         (*standard-input* input) (*terminal-io* terminal) (*query-io* terminal) (*debug-io* terminal)
         (*rpc-runtime* runtime) (*standard-output* (rpc-runtime-diagnostic runtime))
        (*error-output* (rpc-runtime-diagnostic runtime))
        (*trace-output* (rpc-runtime-diagnostic runtime)))
    (loop
      (let ((task
              (sb-thread:with-mutex ((rpc-runtime-lock runtime))
                (loop while (and (null (rpc-pending-work runtime control))
                                 (not (rpc-runtime-input-closed runtime))
                                 (not (rpc-runtime-stop runtime)))
                      do (sb-thread:condition-wait (rpc-runtime-changed runtime)
                                                   (rpc-runtime-lock runtime)))
                (when (or (rpc-runtime-stop runtime)
                          (null (rpc-pending-work runtime control))) (return))
                (rpc-pop-work runtime control))))
        (rpc-emit runtime (rpc-run-work task))))))

(defun rpc-queue-work (id name expression request &key control)
  (let ((runtime *rpc-runtime*))
    (sb-thread:with-mutex ((rpc-runtime-lock runtime))
      (setf (gethash id (rpc-runtime-calls runtime)) t)
      (let ((entry (list (list id name expression request))))
        (cond ((eq control :interrupt)
               (setf (rpc-runtime-interrupt-work runtime) (nconc (rpc-runtime-interrupt-work runtime) entry)))
              (control (setf (rpc-runtime-control-work runtime) (nconc (rpc-runtime-control-work runtime) entry)))
              (t (setf (rpc-runtime-work runtime) (nconc (rpc-runtime-work runtime) entry)))))
      (sb-thread:condition-broadcast (rpc-runtime-changed runtime))))
  nil)

(defun rpc-versioned-tool (name description properties required &optional read-only)
  (let ((tool (jso "name" name "description" description
                   "inputSchema" (jso "type" "object" "properties" properties
                                      "required" required "additionalProperties" 'yason:false))))
    (when (string= (rpc-runtime-version *rpc-runtime*) "2025-06-18")
      (setf (gethash "annotations" tool)
            (jso "readOnlyHint" (rpc-boolean read-only)
                 "destructiveHint" (rpc-boolean (not read-only))
                 "idempotentHint" (rpc-boolean read-only)
                 "openWorldHint" (rpc-boolean (not read-only)))))
    tool))

(defun rpc-identity-schema ()
  (jso "request_id" (jso "type" "string" "minLength" 1)
       "boot_id" (jso "type" "string" "minLength" 1)
       "service_id" (jso "type" "string" "minLength" 1)))

(defun rpc-tools ()
  (if (string= *profile* "generic") (generic-tools)
      (append (when (sb-thread:with-mutex ((rpc-runtime-lock *rpc-runtime*))
                       (rpc-runtime-interrupt-supported *rpc-runtime*))
                (list (rpc-versioned-tool "genera_interrupt"
                        "Interrupt one request; success requires its terminal interrupted outcome."
                        (let ((properties (rpc-identity-schema)))
                          (setf (gethash "timeout_ms" properties)
                                (jso "type" "integer" "minimum" 1 "maximum" 5000))
                          properties) #("request_id" "boot_id" "service_id"))))
      (list (rpc-versioned-tool "genera_session_status" "Return cached Genera status, with optional bounded live refresh."
                                 (jso "refresh" (jso "type" "boolean")) #() t)
            (rpc-versioned-tool "genera_ensure_session" "Join startup or retry one bounded start-or-attach cycle."
                                 (jso) #())
            (rpc-versioned-tool "genera_eval" "Evaluate one form in the attached Genera session."
              (jso "form" (jso "type" "string") "package" (jso "type" "string" "minLength" 1)
                   "timeout_ms" (jso "type" "integer" "minimum" 1)
                   "print_level" (jso "type" #("integer" "null") "minimum" 0)
                   "print_length" (jso "type" #("integer" "null") "minimum" 0)) #("form"))
            (rpc-versioned-tool "eval_genera" "Compatibility alias for genera_eval."
                                 (jso "expression" (jso "type" "string")) #("expression"))
            (rpc-versioned-tool "genera_load" "Verify and load one source file without replay."
              (jso "path" (jso "type" "string" "minLength" 1)
                   "path_kind" (jso "type" "string" "enum" #("genera" "host" "relative"))
                   "package" (jso "type" "string" "minLength" 1)
                   "timeout_ms" (jso "type" "integer" "minimum" 1)
                   "print_level" (jso "type" #("integer" "null") "minimum" 0)
                   "print_length" (jso "type" #("integer" "null") "minimum" 0)) #("path" "path_kind"))
            (rpc-versioned-tool "genera_compile_file" "Compile a verified source file; optionally load successful output."
              (jso "path" (jso "type" "string" "minLength" 1)
                   "path_kind" (jso "type" "string" "enum" #("genera" "host" "relative"))
                   "load" (jso "type" "boolean" "default" 'yason:false)
                   "package" (jso "type" "string" "minLength" 1)
                   "timeout_ms" (jso "type" "integer" "minimum" 1)
                   "print_level" (jso "type" #("integer" "null") "minimum" 0)
                   "print_length" (jso "type" #("integer" "null") "minimum" 0)) #("path" "path_kind"))
            (rpc-versioned-tool "genera_reset_listener_context"
              "Restore the configured bridge package; preserve world state and request history. Requires idle, resolved execution."
              (jso "boot_id" (jso "type" "string" "minLength" 1)
                   "service_id" (jso "type" "string" "minLength" 1)
                   "timeout_ms" (jso "type" "integer" "minimum" 1)) #("boot_id" "service_id"))
            (rpc-versioned-tool "genera_request_status" "Look up a request without replay; retry control connection if needed."
              (rpc-identity-schema) #("request_id" "boot_id" "service_id") t)
            (rpc-versioned-tool "genera_recover_session" "Acknowledge a specific unknown outcome after fresh idle verification."
              (let ((properties (rpc-identity-schema)))
                (setf (gethash "expected_boot_id" properties) (jso "type" "string" "minLength" 1)
                      (gethash "expected_service_id" properties) (jso "type" "string" "minLength" 1)
                      (gethash "acknowledge_unknown" properties) (jso "type" "boolean" "const" 'yason:true))
                properties)
              #("request_id" "boot_id" "service_id" "expected_boot_id" "expected_service_id" "acknowledge_unknown"))))))

(defun handle-initialize (id params)
  (multiple-value-bind (version present) (gethash "protocolVersion" params)
    (when (and present (not (stringp version))) (rpc-invalid "protocolVersion must be text"))
    (setf (rpc-runtime-version *rpc-runtime*)
          (cond ((null version) "2024-11-05")
                ((member version '("2024-11-05" "2025-06-18") :test #'string=) version)
                (t "2025-06-18"))
          (rpc-runtime-initialized *rpc-runtime*) t)
    (make-response id (jso "protocolVersion" (rpc-runtime-version *rpc-runtime*)
                          "capabilities" (jso "tools" (jso "listChanged" (rpc-boolean (string= *profile* "genera"))))
                          "serverInfo" (jso "name" "lisp-mcp" "version" "1.0.0")))))

(defun rpc-start-session ()
  (when (and (string= *profile* "genera") (null (rpc-runtime-session *rpc-runtime*)))
    (let ((runtime *rpc-runtime*))
    (setf (rpc-runtime-session *rpc-runtime*)
          (genera-begin-session :host *genera-host* :port *genera-port*
                                :token *genera-token*
                                :expected-world *genera-expected-world*
                                :connect-timeout *genera-connect-timeout* :boot-timeout *genera-boot-timeout*
                                :runtime *genera-runtime* :startup-managed (genera-local-autostart-p *genera-runtime*)
                                :features-changed (lambda (features) (rpc-note-features runtime features))
                                :reconnect t)))))

(defun rpc-validate-arguments (name arguments)
  (unless (hash-table-p arguments) (rpc-invalid "Tool arguments must be an object"))
  (let* ((structured (and (string= *profile* "genera") (string= name "genera_eval")))
         (status (string= name "genera_session_status"))
         (ensure (string= name "genera_ensure_session"))
         (lookup (string= name "genera_request_status"))
         (recover (string= name "genera_recover_session"))
         (interrupt (string= name "genera_interrupt"))
         (reset (string= name "genera_reset_listener_context"))
         (loading (rpc-file-tool-p name))
         (allowed (cond ((or lookup recover interrupt)
                         (append '("request_id" "boot_id" "service_id")
                                 (when interrupt '("timeout_ms"))
                                 (when recover '("expected_boot_id" "expected_service_id" "acknowledge_unknown"))))
                        (loading (append '("path" "path_kind" "package" "timeout_ms" "print_level" "print_length")
                                         (when (string= name "genera_compile_file") '("load"))))
                        (reset '("boot_id" "service_id" "timeout_ms"))
                        (ensure nil) (status '("refresh")) (structured '("form" "package" "print_level" "print_length" "timeout_ms"))
                        (t '("expression"))))
         (form-key (if structured "form" "expression")))
    (maphash (lambda (key value)
               (declare (ignore value))
               (unless (member key allowed :test #'equal) (rpc-invalid "Unknown tool argument"))) arguments)
    (multiple-value-bind (refresh present) (gethash "refresh" arguments)
      (when (and present (not (member refresh '(yason:true yason:false))))
        (rpc-invalid "refresh must be a boolean")))
    (multiple-value-bind (load present) (gethash "load" arguments)
      (when (and present (not (member load '(yason:true yason:false))))
        (rpc-invalid "load must be a boolean")))
    (when (or lookup recover interrupt reset)
      (dolist (key (if recover '("request_id" "boot_id" "service_id" "expected_boot_id" "expected_service_id")
                              (if reset '("boot_id" "service_id") '("request_id" "boot_id" "service_id"))))
        (let ((value (gethash key arguments)))
          (unless (and (stringp value) (<= 1 (length value) 4096))
            (rpc-invalid "Request and generation identities must be nonempty text"))))
      (when (and recover (not (eq (gethash "acknowledge_unknown" arguments) 'yason:true)))
        (rpc-invalid "acknowledge_unknown must be true")))
    (when (and interrupt (integerp (gethash "timeout_ms" arguments 5000))
               (> (gethash "timeout_ms" arguments 5000) 5000))
      (rpc-invalid "Interrupt timeout_ms must be at most 5000"))
    (when loading
      (unless (and (stringp (gethash "path" arguments)) (<= 1 (length (gethash "path" arguments)) 4096)
                   (member (gethash "path_kind" arguments) '("genera" "host" "relative") :test #'equal))
        (rpc-invalid "File execution requires a nonempty path and explicit path_kind")))
    (unless (or status lookup recover ensure interrupt reset loading)
      (unless (stringp (gethash form-key arguments)) (rpc-invalid "Form/expression must be text")))
    (multiple-value-bind (package present) (gethash "package" arguments)
      (when (and present (not (and (stringp package) (plusp (length package)))))
        (rpc-invalid "Package must be nonempty text")))
    (dolist (key '("print_level" "print_length"))
      (let ((value (gethash key arguments)))
        (unless (or (null value) (and (integerp value) (>= value 0)))
          (rpc-invalid "Print limits must be nonnegative integers or null")))))
  (multiple-value-bind (timeout present) (gethash "timeout_ms" arguments)
    (when (and present (not (and (integerp timeout) (> timeout 0))))
      (rpc-invalid "timeout_ms must be a positive integer"))))

(defun handle-tools-call (id params)
  (let* ((name (gethash "name" params)) (arguments (gethash "arguments" params (jso))))
    (unless (and (stringp name) (find name (rpc-tools) :key (lambda (tool) (gethash "name" tool))
                                                               :test #'string=))
      (rpc-invalid "Unknown or disabled tool"))
    (rpc-validate-arguments name arguments)
    (when (and (string= name "genera_session_status")
               (not (eq (gethash "refresh" arguments) 'yason:true)))
      (return-from handle-tools-call (rpc-structured-result id (rpc-session-status))))
    (sb-thread:with-mutex ((rpc-runtime-lock *rpc-runtime*))
      (when (>= (hash-table-count (rpc-runtime-calls *rpc-runtime*)) +rpc-work-limit+)
        (return-from handle-tools-call (rpc-tool-failure id "busy" "MCP tool capacity is occupied"))))
    (if (string= *profile* "generic")
        (rpc-queue-work id name (gethash "expression" arguments) nil)
        (let ((session (rpc-runtime-session *rpc-runtime*)))
          (when (string= name "genera_ensure_session")
            (return-from handle-tools-call
              (if session
                  (rpc-queue-work id name (genera-start-cycle session) nil)
                  (rpc-tool-failure id "not-ready" "Send notifications/initialized before ensuring Genera"))))
          (when (member name '("genera_request_status" "genera_recover_session" "genera_session_status" "genera_interrupt") :test #'equal)
            (return-from handle-tools-call
              (if session (rpc-queue-work id name arguments nil :control (if (string= name "genera_interrupt") :interrupt t))
                  (rpc-tool-failure id "not-ready" "Genera session has not started"))))
          (unless (and session (eq (genera-session-state session) :ready))
            (return-from handle-tools-call
              (let ((failure (and session (genera-session-failure session))))
                (rpc-tool-failure id
                  (if failure
                      (rpc-name (or (getf (getf (genera-session-error-response failure) :error) :code)
                                    (genera-session-error-kind failure))) "not-ready")
                  (if failure (princ-to-string failure) "Genera session is not ready")))))
          (handler-case
              (let* ((reset (string= name "genera_reset_listener_context"))
                     (loading (rpc-file-tool-p name))
                     (form (gethash (if (string= name "genera_eval") "form" "expression") arguments))
                     (fields (append
                               (list :host-timeout (/ (gethash "timeout_ms" arguments
                                                              (* 1000 *genera-timeout*)) 1000))
                               (cond (loading (list :defer t))
                                 (reset
                                   (list :expected-generation (list (gethash "boot_id" arguments)
                                                                    (gethash "service_id" arguments))))
                                 (t (append (list :form form :print-level (gethash "print_level" arguments 6)
                                                 :print-length (gethash "print_length" arguments 100))
                                           (when (gethash "package" arguments)
                                             (list :package (gethash "package" arguments))))))))
                     (request (apply #'genera-submit-request session
                                     (cond ((string= name "genera_compile_file") :compile-file)
                                           (loading :load) (reset :reset-listener-context) (t :eval)) fields)))
                (rpc-queue-work id name (if loading arguments form) request))
            (genera-session-error (condition)
              (rpc-tool-failure id (rpc-name (genera-session-error-kind condition))
                                (princ-to-string condition) nil
                                (when (rpc-file-tool-p name) (rpc-load-context arguments nil))))
            (error () (rpc-tool-failure id "invalid-source" "Source cannot be sent to Genera")))))))

(defun handle-request (message)
  (unless (hash-table-p message)
    (return-from handle-request (make-error-response nil +invalid-request+ "Expected a request object")))
  (let ((method (gethash "method" message)) (params (gethash "params" message (jso))))
    (multiple-value-bind (id present) (gethash "id" message)
      (unless (and (equal "2.0" (gethash "jsonrpc" message)) (stringp method)
                   (or (not present) (stringp id) (integerp id)))
        (return-from handle-request (make-error-response nil +invalid-request+ "Invalid JSON-RPC request")))
      (unless present
        (when (and (string= method "notifications/initialized")
                   (rpc-runtime-initialized *rpc-runtime*)) (rpc-start-session))
        (return-from handle-request nil))
      (sb-thread:with-mutex ((rpc-runtime-lock *rpc-runtime*))
        (when (gethash id (rpc-runtime-calls *rpc-runtime*))
          (return-from handle-request
            (make-error-response nil +invalid-request+ "Request ID is already pending"))))
      (handler-case
          (progn
            (unless (hash-table-p params) (rpc-invalid "Params must be an object"))
            (cond ((string= method "initialize") (handle-initialize id params))
                  ((string= method "tools/list") (make-response id (jso "tools" (coerce (rpc-tools) 'vector))))
                  ((string= method "tools/call") (handle-tools-call id params))
                  ((string= method "ping") (make-response id (jso)))
                  (t (make-error-response id +method-not-found+ "Method not found"))))
        (rpc-argument-error (condition) (make-error-response id +invalid-params+ (princ-to-string condition)))
        (error () (make-error-response id +internal-error+ "Request dispatch failed"))))))

(defun rpc-shutdown (runtime)
  (sb-thread:with-mutex ((rpc-runtime-lock runtime))
    (setf (rpc-runtime-input-closed runtime) t)
    (when (string= *profile* "genera") (setf (rpc-runtime-stop runtime) t))
    (sb-thread:condition-broadcast (rpc-runtime-changed runtime)))
  (when (rpc-runtime-session runtime)
    (genera-close-session (rpc-runtime-session runtime) :interrupt-io t))
  ;; Generic stdin batches retain their previous ordered drain behavior.
  (sb-thread:join-thread (rpc-runtime-worker runtime))
  (sb-thread:join-thread (rpc-runtime-control-worker runtime))
  (sb-thread:join-thread (rpc-runtime-interrupt-worker runtime))
  (sb-thread:with-mutex ((rpc-runtime-lock runtime))
    (setf (rpc-runtime-writer-stop runtime) t)
    (sb-thread:condition-broadcast (rpc-runtime-changed runtime)))
  (if (string= *profile* "generic")
      (sb-thread:join-thread (rpc-runtime-writer runtime))
      (let ((writer (rpc-runtime-writer runtime)))
        (sb-thread:join-thread writer :timeout .25 :default nil)
        (when (sb-thread:thread-alive-p writer)
          ;; Genera's socket and the tool worker are already closed. Avoid
          ;; SBCL's exit-time stdout flush waiting on a non-reading client.
          (sb-ext:exit :code 0 :abort t)))))

(defun main ()
  (handler-case (configure)
    (configuration-error (condition) (log-message "~A" condition) (uiop:quit 2)))
  (log-message "lisp-mcp server starting (profile ~A)" *profile*)
  (let* ((runtime (make-rpc-runtime :input *standard-input* :output *standard-output*
                                   :diagnostic *error-output*)) (*rpc-runtime* runtime))
    (setf (rpc-runtime-writer runtime)
          (sb-thread:make-thread (lambda () (rpc-write-loop runtime)) :name "MCP response")
          (rpc-runtime-worker runtime)
          (sb-thread:make-thread (lambda () (rpc-work-loop runtime)) :name "MCP tools")
          (rpc-runtime-control-worker runtime)
          (sb-thread:make-thread (lambda () (rpc-work-loop runtime t)) :name "MCP controls")
          (rpc-runtime-interrupt-worker runtime)
          (sb-thread:make-thread (lambda () (rpc-work-loop runtime :interrupt)) :name "MCP interrupt confirmation"))
    (unwind-protect
        (loop
          (let ((message (handler-case (read-json-rpc)
                           (error () :parse-error))))
            (when (eq message :eof) (return))
            (rpc-emit runtime (if (eq message :parse-error)
                                  (make-error-response nil +parse-error+ "Invalid JSON")
                                  (handle-request message)))))
      (rpc-shutdown runtime))))
